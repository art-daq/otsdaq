	<ROOT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="TableInfo.xsd">
		<TABLE Name="DesktopIconTable">
			<VIEW Name="DESKTOP_ICON_TABLE" Type="File,Database,DatabaseTest" Description="This%20table%20is%20used%20to%20specify%20the%20Icons%20available%20on%20the%20otsdaq%20Desktop.%20%0A%0AUsually%20a%20Desktop%20Icon%20opens%20the%20GUI%20to%20an%20otsdaq%20app%2C%20but%20an%20Icon%20may%20be%20configured%20to%20open%20any%20content%20accessible%20through%20the%20user's%20browser%20(Note%3A%20the%20target%20server%20may%20have%20to%20allow%20cross-origin%20requests%20for%20full%20functionality).%20%0A%0A%3Cb%3EPro%20Tip%3A%3C%2Fb%3E%20if%20you%20hold%20down%20your%20mouse%20button%20for%203%20seconds%20on%20any%20Desktop%20Icon%20or%20Folder%2C%20you%20can%20open%20the%20item%20directly%20in%20full%20screen%20or%20in%20a%20new%20browser%20tab.%0A%0AHere%20is%20an%20explanation%20of%20the%20features%20associated%20with%20each%20column%3A%0A%3CINDENT%3E%0A-%20%3Cb%3EIconName%3C%2Fb%3E%3A%0A%3CINDENT%3EThis%20is%20the%20unique%20ID%20value%20for%20each%20row.%3C%2FINDENT%3E%0A-%20%3Cb%3EStatus%3C%2Fb%3E%3A%0A%3CINDENT%3EIf%20On%2C%20the%20Icon%20will%20be%20shown%20on%20the%20Desktop.%20When%20Off%2C%20the%20Icon%20will%20not%20be%20displayed.%3C%2FINDENT%3E%0A-%20%3Cb%3ECaption%3C%2Fb%3E%3A%0A%3CINDENT%3EThis%20is%20the%20text%20shown%20underneath%20the%20Icon.%3C%2FINDENT%3E%0A-%20%3Cb%3EAlternateText%3C%2Fb%3E%3A%0A%3CINDENT%3EIf%20the%20ImageURL%20is%20omitted%20(left%20as%20default%20or%20blank)%2C%20then%20the%20alternate%20text%20is%20used%20in%20place%20of%20the%20Icon%20image.%20This%20is%20useful%20if%20you%20have%20not%20yet%20found%20an%20image%20to%20use%20for%20a%20particular%20icon.%20The%20alternate%20text%20field%20serves%20an%20%3Cu%3Eextra%20purpose%3C%2Fu%3E%20when%20enabling%20%3Cb%3ERemote%20Gateway%20Subsystems%3C%2Fb%3E%20(see%20the%20%3Cb%3EAdvanced%20Subsystem%20Configuration%20Features%3C%2Fb%3E%20below)%20-%20in%20this%20case%2C%20it%20must%20be%20the%20corresponding%20record%20UID%20in%20the%20%3Cb%3ESubsystemUserDataPathsTable%3C%2Fb%3E.%3C%2FINDENT%3E%0A-%20%3Cb%3EForceOnlyOneInstance%3C%2Fb%3E%3A%0A%3CINDENT%3EIf%20True%2C%20then%20only%20window%20is%20allowed%20on%20the%20Desktop.%20If%20False%2C%20then%20each%20time%20the%20Icon%20is%20clicked%20a%20new%20instance%20of%20the%20window%20will%20open.%20For%20example%2C%20it%20is%20common%20to%20force%20only%20one%20instance%20of%20the%20state%20machine%20window.%3C%2FINDENT%3E%0A-%20%3Cb%3ERequiredPermissionLevel%3C%2Fb%3E%3A%0A%3CINDENT%3EThis%20value%20is%20the%20minimum%20permission%20level%20for%20a%20user%20to%20have%20access%20to%20this%20Icon.%20If%20a%20user%20has%20insufficient%20access%2C%20the%20Icon%20will%20not%20appear%20on%20their%20Desktop.%20As%20a%20reminder%2C%20permission%20levels%20go%20from%201%20(lowest)%20to%20255%20(admin-level)%3B%20and%20only%20admins%20can%20modify%20the%20access%20level%20of%20users.%3C%2FINDENT%3E%0A-%20%3Cb%3EImageURL%3C%2Fb%3E%3A%0A%3CINDENT%3EThis%20is%20the%20URL%20to%20the%20image%20used%20for%20the%20Icon.%20The%20native%20resolution%20for%20Icons%20is%2064%20x%2064%20pixels.%20If%20left%20as%20the%20default%20value%20or%20blank%2C%20the%20the%20AlternateText%20field%20will%20be%20used%20for%20the%20Icon%20image.%20The%20image%20URL%20is%20not%20used%20when%20enabling%20%3Cb%3ERemote%20Gateway%20Subsystems%3C%2Fb%3E.%3C%2FINDENT%3E%0A-%20%3Cb%3EWindowContentURL%3C%2Fb%3E%3A%0A%3CINDENT%3EThis%20is%20the%20URL%20of%20the%20window%20content%20that%20will%20be%20opened%20when%20the%20user%20clicks%20this%20Icon.%20The%20window%20content%20is%20usually%20an%20otsdaq%20app%20but%20may%20be%20any%20web%20content%20accessible%20through%20the%20user's%20browser.%20The%20window%20content%20URL%20field%20serves%20an%20%3Cu%3Eextra%20purpose%3C%2Fu%3E%20when%20enabling%20%3Cb%3ERemote%20Gateway%20Subsystems%3C%2Fb%3E%20(see%20the%20%3Cb%3EAdvanced%20Subsystem%20Configuration%20Features%3C%2Fb%3E%20below)%20-%20in%20this%20case%2C%20it%20must%20be%20in%20the%20format%20ots%3A%3CRemote%20Subsystem%20Gateway%20IP%20address%3E%3A%3CRemote%20Subsystem%20Gateway%20Port%20for%20state%20changes%20(spec'd%20in%20%3Cb%3EGatewaySupervisorTable%3C%2Fb%3E%20of%20Remote%20Subsystem)%3E.%3C%2FINDENT%3E%0A-%20%3Cb%3ELinkToApplicationTable%2FUID%3C%2Fb%3E%3A%0A%3CINDENT%3EWhen%20the%20Icon%20refers%20to%20an%20otsdaq%20app%2C%20these%20two%20fields%20comprise%20the%20table%20link%20that%20connects%20the%20Icon%20to%20the%20app's%20ID%20-%20the%20app%20ID%20is%20used%20to%20target%20the%20app%20when%20sending%20requests.%20The%20LinkToApplicationTable%20field%20is%20the%20table%20table%20part%20of%20the%20link%20and%20the%20ApplicationUID%20field%20is%20the%20UID%20part%20of%20the%20link.%3C%2FINDENT%3E%0A-%20%3Cb%3ELinkToParameterTable%2FGroupID%3C%2Fb%3E%3A%0A%3CINDENT%3EWhen%20the%20Icon%20refers%20to%20a%20window%20with%20GET%20parameters%2C%20these%20two%20fields%20comprise%20the%20table%20link%20to%20the%20group%20of%20GET%20parameters%20that%20will%20be%20passed%20to%20the%20window%20when%20opened.%20GET%20parameters%20are%20added%20after%20the%20'%3F'%20in%20a%20URL.%20The%20window%20source%20code%20(i.e.%20HTML%20and%20JavaScript)%20can%20then%20use%20these%20parameters%20to%20affect%20the%20presentation%20of%20content.%3C%2FINDENT%3E%0A-%20%3Cb%3EFolderPath%3C%2Fb%3E%3A%0A%3CINDENT%3EThis%20field%20is%20used%20to%20organize%20Icons%20into%20folders%20on%20the%20Desktop.%20For%20example%2C%20a%20value%20of%20%22myFolder%2FmySubfolder%22%20places%20this%20Icon%20inside%20a%20folder%20named%20%22mySubFolder%22%20which%20is%20inside%20the%20folder%20%22myFolder%22%20on%20the%20Desktop.%20The%20folder%20path%20field%20serves%20an%20%3Cu%3Eextra%20purpose%3C%2Fu%3E%20when%20enabling%20%3Cb%3ERemote%20Gateway%20Subsystems%3C%2Fb%3E%20(see%20the%20%3Cb%3EAdvanced%20Subsystem%20Configuration%20Features%3C%2Fb%3E%20below)%20-%20in%20this%20case%2C%20the%20folder%20will%20be%20populated%20by%20all%20of%20the%20desktop%20icons%20defined%20in%20the%20%3Cb%3EDesktopIconTable%3C%2Fb%3E%20of%20the%20%3Cb%3ERemote%20Subsystem%20active%20Context%20group%3C%2Fb%3E.%20%3Cb%3EPro%20Tip%3A%3C%2Fb%3E%20if%20you%20hold%20down%20your%20mouse%20button%20for%203%20seconds%20on%20a%20Remote%20Subsystem%20folder%20you%20can%20open%20the%20Remote%20Subsystem%20icons%20in%20a%20separate%20browser%20tab%20-%20a%20%3Cb%3Esubsystem%20focused%20view%3C%2Fb%3E.%3C%2FINDENT%3E%0A%3C%2FINDENT%3E%0A%0A%0A%3Cb%3EAdvanced%20Subsystem%20Configuration%20Features%3C%2Fb%3E%3A%0A%3CTAB%3E%0A%3Cb%3E%3Ci%3Eotsdaq%3C%2Fi%3E%3C%2Fb%3E%20also%20supports%20controlling%20and%20monitoring%20subsystems.%20You%20can%20enable%20%3Cb%3ERemote%20Gateway%20Subsystems%3C%2Fb%3E%20at%20the%20top%20level%20%3Cb%3E%3Ci%3Eots%3C%2Fi%3E%3C%2Fb%3E%20instance%20by%20adding%20subsystems%20in%20your%20active%20Context%20group%20as%20a%20Desktop%20Icon%20(%3Cb%3EDesktopIconTable%3C%2Fb%3E)%20linked%20to%20a%20Subsystem%20User%20Path%20(%3Cb%3ESubsystemUserDataPathsTable%3C%2Fb%3E).%20%0A%0A%0AWhen%20%3Cb%3ERemote%20Gateway%20Subsystems%3C%2Fb%3E%20are%20enabled%2C%20%3Cb%3ESubsystemCommon%3C%2Fb%3E%20defines%20tables%20to%20be%20merged%20into%20the%20Subsystem%20Configuration%20at%20the%20Configure%20transition%20-%20if%20there%20are%20record%20conflicts%2C%20the%20existing%20Subsystem%20Configuration%20takes%20priority.%20%3Cb%3ESubsystemCommonOverride%3C%2Fb%3E%20defines%20tables%20to%20be%20merged%20into%20the%20Subsystem%20Configuration%20at%20the%20Configure%20transition%20-%20if%20there%20are%20record%20conflicts%2C%20the%20incoming%20top-level%20specified%20alias%20records%20override%20the%20existing%20Subsystem%20Configuration%20record.%0A%3C%2FTAB%3E">
