	<ROOT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="TableInfo.xsd">
		<TABLE Name="SubsystemUserDataPathsTable">
			<VIEW Name="SUBSYSTEM_USER_DATA_PATHS_TABLE" Type="File,Database,DatabaseTest" Description="The%20%3Cb%3ESubsystemUserDataPathsTable%3C%2Fb%3E%20provides%20a%20mapping%20from%20Subsystem%20name%20to%20the%20associated%20Subsystem%20User%20Data%20path.%20In%20a%20multi-subsystem%20environment%2C%20it%20may%20be%20useful%20to%20inspect%2Fcopy%2Fcompare%20configurations%20of%20other%20subsystems.%20The%20mapping%20within%20this%20table%20provides%20the%20lookup%20information%20to%20find%20the%20active%20table%20groups%20of%20all%20subsystems%2C%20thus%20allowing%20for%20the%20lookup%20of%20their%20active%20Backbone%20group%20(i.e.%2C%20group%20and%20table%20aliases)%20-%20this%20lookup%20is%20accessible%20from%20%3Cb%3ESystem%20View%20of%20the%20Configuration%20GUI%3C%2Fb%3E.%0A%0A%3Cb%3E%3Ci%3Eotsdaq%3C%2Fi%3E%3C%2Fb%3E%20also%20supports%20controlling%20and%20monitoring%20subsystems.%20You%20can%20enable%20%3Cb%3ERemote%20Gateway%20Subsystems%3C%2Fb%3E%20at%20the%20top%20level%20%3Cb%3E%3Ci%3Eots%3C%2Fi%3E%3C%2Fb%3E%20instance%20by%20adding%20subsystems%20in%20your%20active%20Context%20group%20as%20a%20Desktop%20Icon%20(%3Cb%3EDesktopIcontTable%3C%2Fb%3E)%20linked%20to%20a%20Subsystem%20User%20Path%20(%3Cb%3ESubsystemUserDataPathsTable%3C%2Fb%3E).%20%0A%0A%0A%3Cb%3EAdvanced%20Subsystem%20Configuration%20Features%3C%2Fb%3E%3A%0A%0AWhen%20%3Cb%3ERemote%20Gateway%20Subsystems%3C%2Fb%3E%20are%20enabled%2C%20%3Cb%3ESubsystemCommon%3C%2Fb%3E%20defines%20tables%20to%20be%20merged%20into%20the%20Subsystem%20Configuration%20at%20the%20Configure%20transition%20-%20if%20there%20are%20record%20conflicts%2C%20the%20existing%20Subsystem%20Configuration%20takes%20priority.%20%3Cb%3ESubsystemCommonOverride%3C%2Fb%3E%20defines%20tables%20to%20be%20merged%20into%20the%20Subsystem%20Configuration%20at%20the%20Configure%20transition%20-%20if%20there%20are%20record%20conflicts%2C%20the%20incoming%20top-level%20specified%20alias%20records%20override%20the%20existing%20Subsystem%20Configuration%20record.">
				<COLUMN Type="UID" 	 Name="SubsystemUID" 	 StorageName="SUBSYSTEM_UID" 		DataType="STRING" 		DataChoices=""/>
				<COLUMN Type="Data" 	 Name="SubsystemFullName" 	 StorageName="SUBSYSTEM_FULL_NAME" 		DataType="STRING" 		DataChoices=""/>
