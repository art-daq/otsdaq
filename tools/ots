# function to kill all things ots
function killprocs
{

	if [ $ISREMOTE == 0 ]; then
		out "Killing processes $1..."
	fi

	if [[ "x$1" == "x" ]]; then #kill all ots processes that share "$USER_DATA/" (Note: without the trailing /, shift will kill shift1)

		pids=`ps aux|grep -v grep|grep [x]daq.exe|grep "${USER_DATA}/"|awk '{print $2}'`
		for pid in $pids;do
			killproc $pid xdaq.exe &
		done
		pids=`ps aux|grep -v grep|grep [o]tsConsoleFwd|grep "${USER_DATA}/"|awk '{print $2}'`
		for pid in $pids;do
			killproc $pid otsConsoleFwd &
		done
		unset MF_FWD_PID

		# for now (Aug-2023), stop killing artdaq and trust artdaq cleanup (this will also allowed share user accounts)
		# usershort=`echo $USER|cut -c 1-10`
		# for key in `ipcs|grep $usershort|grep ' 0 '|awk '{print $1}'`;do ipcrm -M $key;done

		sleep 1 #give time for cleanup to occur


	else #then killing only non-gateway contexts

		i=0
		for contextPID in "${ContextPIDArray[@]}"
		do

			if [ $ISREMOTE == 0 ]; then
				out "${Red}${Rev}Killing Non-gateway context ${ContextPIDNameArray[$i]}, PID ${contextPID}${RstClr}"
			else
				out "${Red}${Rev}Killing Non-gateway context ${ContextPIDNameArray[$i]}, PID ${contextPID}${RstClr}"
			fi

			killproc ${contextPID} non-gateway &

			i=$(( $i + 1 ))
		done

		unset ContextPIDArray #done with array of PIDs, so clear
		unset ContextPIDNameArray #done with array of PIDs, so clear
		unset ContextPIDIsAliveArray #done with array of PIDs, so clear

		if [[ $1 == "ownedProcesses" && -v GATEWAY_PID ]]; then #in this case if variable is set, kill gateway too
			out "${Red}${Rev}Killing Gateway process ID ${GATEWAY_PID}${RstClr}"
			killproc ${GATEWAY_PID} gateway &
			unset GATEWAY_PID
		fi

		sleep 1 #give time for cleanup to occur
	fi

	#kill lingering artdaq processes by partition number
	pids=`ps aux|grep -v grep|grep "partition_number: ${ARTDAQ_PARTITION}"|awk '{print $2}'`
	for pid in $pids;do
		killproc $pid artdaq &
	done
	pids=`ps aux|grep -v grep|grep "partition_${ARTDAQ_PARTITION}"|awk '{print $2}'`
	for pid in $pids;do
		killproc $pid artdaq &
	done
	pids=`ps aux|grep -v grep|grep "art -c ${USER_DATA}/"|awk '{print $2}'`
	for pid in $pids;do
		killproc $pid art &
	done
	pids=`ps aux|grep -v grep|grep "partition_number: ${ARTDAQ_PARTITION}"|awk '{print $2}'`
	for pid in $pids;do
		killproc $pid boardreader &
	done
	pids=`ps aux|grep -v grep|grep "partition_number: ${ARTDAQ_PARTITION}"|awk '{print $2}'`
	for pid in $pids;do
		killproc $pid eventbuilder &
	done
	pids=`ps aux|grep -v grep|grep "partition_number: ${ARTDAQ_PARTITION}"|awk '{print $2}'`
	for pid in $pids;do
		killproc $pid datalogger &
	done
	pids=`ps aux|grep -v grep|grep "partition_number: ${ARTDAQ_PARTITION}"|awk '{print $2}'`
	for pid in $pids;do
		killproc $pid dispatcher &
	done
	pids=`ps aux|grep -v grep|grep "partition_number: ${ARTDAQ_PARTITION}"|awk '{print $2}'`
	for pid in $pids;do
		killproc $pid routing_manager &
	done
	sleep 1
	#do art again, in case art processes were kept alive by artdaq
	pids=`ps aux|grep -v grep|grep "art -c ${USER_DATA}/"|awk '{print $2}'`
	for pid in $pids;do
		killproc $pid art &
	done

	if [ $ISREMOTE == 0 ]; then
		out "Done killing processes $1 ${RstClr}"
	fi

} #end killprocs
