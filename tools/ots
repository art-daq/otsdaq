	# out "These are the corresponding ports for the Context processes: ${gatewayPort} ${xdaqPort[@]}"
	# out "These are the corresponding UIDs for the Context processes:  ${gatewayUID} ${xdaqContextUID[@]}"
	# out #blank line
}


