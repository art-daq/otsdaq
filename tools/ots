launchOTSLogFindARTDAQ() {
	##############################################################################
	# ARTDAQ log find (ots -ll):
	#  1) Runs the full local log find (ots -lll) first.
	#  2) Finds the latest ranks.txt under $USER_DATA/ARTDAQConfigurations/run_records/
	#     and parses unique hostnames from it.
	#  3) For each ARTDAQ host (that is not local), SSHs to it via
	#     fast_ots_setup.sh logs to run ots -lll and display its local logs.
	##############################################################################

	# Step 1: Run the full local log find display (skip context examples -- printed at end)
	LOGFIND_LOCAL_ONLY=1
	LOGFIND_SKIP_CONTEXT_EXAMPLES=1
	launchOTSLogFind
	unset LOGFIND_LOCAL_ONLY
	unset LOGFIND_SKIP_CONTEXT_EXAMPLES

	# Step 2: Find the latest ranks.txt
	out #blank line
	out "${Bold}${Cyan}Searching for ARTDAQ host logs (from latest ranks.txt)...${RstClr}"

	_artdaq_ranks_file=$(find -L "${USER_DATA}/ARTDAQConfigurations/run_records" -maxdepth 2 -name 'ranks.txt' -type f 2>/dev/null \
		| sort -t/ -k$(echo "${USER_DATA}/ARTDAQConfigurations/run_records/" | tr -cd '/' | wc -c) -n \
		| tail -1)

	if [ -z "$_artdaq_ranks_file" ]; then
		out "  ${IBlack}No ranks.txt found under \$USER_DATA/ARTDAQConfigurations/run_records/.${RstClr}"
		out "  ${IBlack}(ARTDAQ host search skipped)${RstClr}"
		unset _artdaq_ranks_file
		_logfind_print_context_examples
		unset -f _logfind_is_local
		return
	fi

	out "  ${IBlack}Using ranks file: ${_artdaq_ranks_file}${RstClr}"

	# Step 3: Parse unique hostnames from ranks.txt (first column, skip header)
	declare -A _artdaq_seen_hosts
	unset _artdaq_hosts
	_artdaq_hosts=()

	# Mark local host as seen so we don't SSH to ourselves
	_artdaq_seen_hosts["${THIS_HOST}"]=1

	while read -r _artdaq_line; do
		# skip empty lines and header line
		[[ -z "$_artdaq_line" ]] && continue
		[[ "$_artdaq_line" == host* ]] && continue

		# first column is the hostname
		_artdaq_host=$(echo "$_artdaq_line" | awk '{print $1}')
		[[ -z "$_artdaq_host" ]] && continue

		# check if already seen or is local
		if [ -n "${_artdaq_seen_hosts[$_artdaq_host]+x}" ]; then
			continue
		fi

		# check if this host is actually local (with -data/-ipmi alias)
		_artdaq_host_stripped="${_artdaq_host/-data/}"
		_artdaq_host_stripped="${_artdaq_host_stripped/-ipmi/}"
		if [[ "$_artdaq_host_stripped" == "${THIS_HOST}" || "$_artdaq_host_stripped" == "${THIS_HOST}."* ]]; then
			_artdaq_seen_hosts["$_artdaq_host"]=1
			continue
		fi

		_artdaq_seen_hosts["$_artdaq_host"]=1
		_artdaq_hosts+=("$_artdaq_host")
	done < "$_artdaq_ranks_file"

	out "  ${IBlack}ARTDAQ hosts found: ${_artdaq_hosts[*]:-none}${RstClr}"

	if [ ${#_artdaq_hosts[@]} -eq 0 ]; then
		out "  ${IBlack}(no remote ARTDAQ hosts to search)${RstClr}"
		unset _artdaq_ranks_file _artdaq_seen_hosts _artdaq_hosts _artdaq_host _artdaq_host_stripped _artdaq_line
		_logfind_print_context_examples
		unset -f _logfind_is_local
		return
	fi

	# Step 4: SSH to each ARTDAQ host and run ots -lll via fast_ots_setup.sh logs
	_lf_ssh_cmd="{ cd '${OTS_SETUP_DIR}/otsdaq-mu2e-config' && source ./Fast_ots_setup.sh '${OTS_SETUP_TYPE}' logs; } 2>&1"

	for _artdaq_host in "${_artdaq_hosts[@]}"; do
		out #blank line
		out "  ${IBlack}[${_artdaq_host}] Searching via SSH:${RstClr}"
		out "  ${IBlack}  ssh -K ${_artdaq_host} \"${_lf_ssh_cmd}\"${RstClr}"

		_lf_ssh_stderr_file=$(mktemp /tmp/ots_ssh_stderr_XXXXXX 2>/dev/null || echo "/tmp/ots_ssh_stderr_$$")
		_lf_ssh_output=$(ssh -K -o ConnectTimeout=10 -o BatchMode=yes "$_artdaq_host" \
			"$_lf_ssh_cmd" 2>"$_lf_ssh_stderr_file")
		_lf_ssh_rc=$?
		_lf_ssh_host_used="$_artdaq_host"

		# If SSH failed, try stripping -data or -ipmi suffix
		if [ $_lf_ssh_rc -ne 0 ]; then
			_lf_alt_host=""
			if [[ "$_artdaq_host" == *"-data"* ]]; then
				_lf_alt_host="${_artdaq_host/-data/}"
			elif [[ "$_artdaq_host" == *"-ipmi"* ]]; then
				_lf_alt_host="${_artdaq_host/-ipmi/}"
			fi

			if [ -n "$_lf_alt_host" ]; then
				out "  ${Yellow}[${_artdaq_host}] SSH failed (exit code ${_lf_ssh_rc}). Retrying with: ${_lf_alt_host}${RstClr}"
				out "  ${IBlack}  ssh -K ${_lf_alt_host} \"${_lf_ssh_cmd}\"${RstClr}"

				_lf_ssh_output=$(ssh -K -o ConnectTimeout=10 -o BatchMode=yes "$_lf_alt_host" \
					"$_lf_ssh_cmd" 2>"$_lf_ssh_stderr_file")
				_lf_ssh_rc=$?
				_lf_ssh_host_used="$_lf_alt_host"

				if [ $_lf_ssh_rc -ne 0 ]; then
					_lf_ssh_errmsg=$(cat "$_lf_ssh_stderr_file" 2>/dev/null | head -3)
					out "  ${Red}[${_artdaq_host}] SSH failed to both ${_artdaq_host} and ${_lf_alt_host} (exit code ${_lf_ssh_rc}). Skipping.${RstClr}"
					if [ -n "$_lf_ssh_errmsg" ]; then
						out "  ${Red}  stderr: ${_lf_ssh_errmsg}${RstClr}"
					fi
					rm -f "$_lf_ssh_stderr_file" 2>/dev/null
					continue
				fi
			else
				_lf_ssh_errmsg=$(cat "$_lf_ssh_stderr_file" 2>/dev/null | head -3)
				out "  ${Red}[${_artdaq_host}] SSH failed (exit code ${_lf_ssh_rc}). Skipping.${RstClr}"
				if [ -n "$_lf_ssh_errmsg" ]; then
					out "  ${Red}  stderr: ${_lf_ssh_errmsg}${RstClr}"
				fi
				rm -f "$_lf_ssh_stderr_file" 2>/dev/null
				continue
			fi
		fi
		rm -f "$_lf_ssh_stderr_file" 2>/dev/null

		out "  ${IBlack}[${_lf_ssh_host_used}] SSH succeeded. Parsing remote ots -lll output...${RstClr}"

		# Parse category+path pairs and time label from the remote ots -lll display output.
		# Remote output lines look like:  "    <category> --> less /path/to/file  (age)"
		# We extract both the category (which may include run# from symlink lookup on the
		# remote host) and the file path, separated by a tab character.
		_lf_remote_entries=""
		_lf_remote_label=""
		while IFS= read -r _lf_line; do
			_lf_clean=$(echo "$_lf_line" | sed 's/\x1b\[[0-9;]*m//g')

			if [[ "$_lf_clean" == *"(local, last "* ]]; then
				_lf_remote_label="${_lf_clean#*\(local, last }"
				_lf_remote_label="${_lf_remote_label%%\)*}"
			fi

			if [[ "$_lf_clean" == *" --> less /"* ]]; then
				# Extract category: everything before " --> less", then strip TRACE prefix
				# TRACE prefix format: "14May26.15:59:57-... hostname ots:NNNN |<TAB><category>"
				# Strip everything up to and including " |" then trim remaining whitespace/tabs
				_lf_remote_cat="${_lf_clean%% --> less *}"
				if [[ "$_lf_remote_cat" == *" |"* ]]; then
					_lf_remote_cat="${_lf_remote_cat##* |}"
				fi
				_lf_remote_cat="${_lf_remote_cat#"${_lf_remote_cat%%[![:space:]]*}"}" # trim leading whitespace/tabs
				# Extract path and age: everything after "less "
				_lf_path="${_lf_clean##*less }"
				_lf_remote_age=""
				if [[ "$_lf_path" == *"("*"ago)"* ]]; then
					_lf_remote_age="${_lf_path##*(}"
					_lf_remote_age="(${_lf_remote_age%%)*})"
				fi
				_lf_path="${_lf_path%% *}"
				if [ -n "$_lf_path" ]; then
					# Store as "category<TAB>path<TAB>age"
					if [ -n "$_lf_remote_entries" ]; then
						_lf_remote_entries="${_lf_remote_entries}"$'\n'"${_lf_remote_cat}	${_lf_path}	${_lf_remote_age}"
					else
						_lf_remote_entries="${_lf_remote_cat}	${_lf_path}	${_lf_remote_age}"
					fi
				fi
			fi
		done <<< "$_lf_ssh_output"

		if [ -n "$_lf_remote_entries" ]; then
			out "  [${_artdaq_host}] (ARTDAQ host, last ${_lf_remote_label}):"
			while IFS=$'\t' read -r _lf_category _lf_file _lf_age; do
				_lf_basename=$(basename "$_lf_file")

				if [[ "$_lf_basename" == "otsdaq_is_alive"* ]]; then continue; fi

				if [ -n "$_lf_age" ]; then
					out "    ${Bold}${_lf_category}${RstClr} --> vless_ots.sh ${_artdaq_host}:${_lf_file}  ${IBlack}${_lf_age}${RstClr}"
				else
					out "    ${Bold}${_lf_category}${RstClr} --> vless_ots.sh ${_artdaq_host}:${_lf_file}"
				fi
			done <<< "$_lf_remote_entries"
		else
			out "  ${IBlack}[${_artdaq_host}] No recently written log files found.${RstClr}"
		fi
	done

	unset _artdaq_ranks_file _artdaq_seen_hosts _artdaq_hosts _artdaq_host _artdaq_host_stripped _artdaq_line
	unset _lf_ssh_cmd _lf_ssh_output _lf_ssh_rc _lf_ssh_host_used _lf_alt_host
	unset _lf_remote_entries _lf_remote_label _lf_remote_cat _lf_remote_age _lf_line _lf_clean _lf_path
	unset _lf_file _lf_basename _lf_category _lf_age

	# Print the context log examples last (deferred from launchOTSLogFind)
	_logfind_print_context_examples
	unset -f _logfind_is_local

}   #end launchOTSLogFindARTDAQ
export -f launchOTSLogFindARTDAQ


