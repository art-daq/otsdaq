# Helper: strip TRACE/ANSI from remote scan output and print relevant lines.
_logscan_ssh_output_filter() {
	local _lsf_host="$1"
	local _lsf_output="$2"
	while IFS= read -r _lsf_rline; do
		local _lsf_clean
		_lsf_clean=$(echo "$_lsf_rline" | sed 's/\x1b\[[0-9;]*m//g')
		if [[ "$_lsf_clean" == *" |"* ]]; then _lsf_clean="${_lsf_clean##* |}"; fi
		_lsf_clean="${_lsf_clean#"${_lsf_clean%%[![:space:]]*}"}"
		if [[ "$_lsf_clean" == "/"* ]] || \
		   [[ "$_lsf_clean" == *"ERROR"* ]] || \
		   [[ "$_lsf_clean" == *"WARN"* ]] || \
		   [[ "$_lsf_clean" == *"Scanning"*"log"* ]] || \
		   [[ "$_lsf_clean" == *"Found"*"file"* ]] || \
		   [[ "$_lsf_clean" == *"No log files"* ]] || \
		   [[ "$_lsf_clean" == *"lines found"* ]] || \
		   [[ "$_lsf_clean" == "Done." ]]; then
			out "    [${_lsf_host}] ${_lsf_clean}"
		fi
	done <<< "$_lsf_output"
}

# Helper: SSH to each ARTDAQ host from ranks.txt and run a logscan action.
# Args: <pattern_label> <fast_ots_action>
_logscan_artdaq_hosts() {
	local _lsa_label="$1"
	local _lsa_action="$2"
	out
	out "${Bold}${Cyan}Scanning recent logs for ${_lsa_label} on remote ARTDAQ hosts...${RstClr}"
	local _lsa_ranks_file
	_lsa_ranks_file=$(find -L "${USER_DATA}/ARTDAQConfigurations/run_records" -maxdepth 2 -name 'ranks.txt' -type f 2>/dev/null \
		| sort -t/ -k$(echo "${USER_DATA}/ARTDAQConfigurations/run_records/" | tr -cd '/' | wc -c) -n \
		| tail -1)
	if [ -n "$_lsa_ranks_file" ]; then
		declare -A _lsa_seen_hosts
		_lsa_seen_hosts["${THIS_HOST}"]=1
		while read -r _lsa_line; do
			[[ -z "$_lsa_line" ]] && continue
			[[ "$_lsa_line" == host* ]] && continue
			local _lsa_host
			_lsa_host=$(echo "$_lsa_line" | awk '{print $1}')
			[[ -z "$_lsa_host" ]] && continue
			[ -n "${_lsa_seen_hosts[$_lsa_host]+x}" ] && continue
			local _lsa_host_stripped="${_lsa_host/-data/}"
			_lsa_host_stripped="${_lsa_host_stripped/-ipmi/}"
			if [[ "$_lsa_host_stripped" == "${THIS_HOST}" || "$_lsa_host_stripped" == "${THIS_HOST}."* ]]; then
				_lsa_seen_hosts["$_lsa_host"]=1
				continue
			fi
			_lsa_seen_hosts["$_lsa_host"]=1
			out "  ${IBlack}[${_lsa_host}] Scanning via SSH...${RstClr}"
			local _lsa_ssh_cmd
			_lsa_ssh_cmd="{ cd '${OTS_SETUP_DIR}/otsdaq-mu2e-config' && source ./Fast_ots_setup.sh '${OTS_SETUP_TYPE}' ${_lsa_action} ${LOGSCAN_TIME_INT} ${LOGSCAN_TIME_UNIT}; } 2>&1"
			local _lsa_ssh_output _lsa_ssh_rc
			_lsa_ssh_output=$(ssh -K -o ConnectTimeout=10 -o BatchMode=yes "$_lsa_host" "$_lsa_ssh_cmd" 2>/dev/null)
			_lsa_ssh_rc=$?
			if [ $_lsa_ssh_rc -ne 0 ]; then
				_lsa_ssh_output=$(ssh -K -o ConnectTimeout=10 -o BatchMode=yes "${_lsa_host/-data/}" "$_lsa_ssh_cmd" 2>/dev/null)
				_lsa_ssh_rc=$?
			fi
			if [ $_lsa_ssh_rc -ne 0 ]; then
				out "  ${Red}[${_lsa_host}] SSH scan failed. Skipping.${RstClr}"
			else
				_logscan_ssh_output_filter "$_lsa_host" "$_lsa_ssh_output"
			fi
		done < "$_lsa_ranks_file"
		unset _lsa_seen_hosts _lsa_host _lsa_host_stripped _lsa_line _lsa_ssh_cmd _lsa_ssh_output _lsa_ssh_rc _lsa_ranks_file
	else
		out "  ${IBlack}No ranks.txt found. Skipping remote ARTDAQ host scan.${RstClr}"
	fi
}

# Helper: SSH to each OTS context host and run a logscan action.
# Args: <pattern_label> <fast_ots_action>
_logscan_context_hosts() {
	local _lsc_label="$1"
	local _lsc_action="$2"
	out
	out "${Bold}${Cyan}Scanning recent logs for ${_lsc_label} on remote OTS context hosts...${RstClr}"
	local _lsc_context_hosts
	_lsc_context_hosts=$(_logdelete_get_context_hosts)
	if [ -n "$_lsc_context_hosts" ]; then
		local _lsc_ssh_cmd
		_lsc_ssh_cmd="{ cd '${OTS_SETUP_DIR}/otsdaq-mu2e-config' && source ./Fast_ots_setup.sh '${OTS_SETUP_TYPE}' ${_lsc_action} ${LOGSCAN_TIME_INT} ${LOGSCAN_TIME_UNIT}; } 2>&1"
		while IFS= read -r _lsc_host; do
			[ -z "$_lsc_host" ] && continue
			out "  ${IBlack}[${_lsc_host}] Scanning via SSH...${RstClr}"
			local _lsc_ssh_output _lsc_ssh_rc
			_lsc_ssh_output=$(ssh -K -o ConnectTimeout=10 -o BatchMode=yes "$_lsc_host" "$_lsc_ssh_cmd" 2>/dev/null)
			_lsc_ssh_rc=$?
			if [ $_lsc_ssh_rc -ne 0 ]; then
				_lsc_ssh_output=$(ssh -K -o ConnectTimeout=10 -o BatchMode=yes "${_lsc_host/-data/}" "$_lsc_ssh_cmd" 2>/dev/null)
				_lsc_ssh_rc=$?
			fi
			if [ $_lsc_ssh_rc -ne 0 ]; then
				out "  ${Red}[${_lsc_host}] SSH scan failed. Skipping.${RstClr}"
			else
				_logscan_ssh_output_filter "$_lsc_host" "$_lsc_ssh_output"
			fi
		done <<< "$_lsc_context_hosts"
		unset _lsc_ssh_cmd _lsc_ssh_output _lsc_ssh_rc _lsc_host
	else
		out "  ${IBlack}No remote OTS context hosts found in XML config.${RstClr}"
	fi
	unset _lsc_context_hosts
}

