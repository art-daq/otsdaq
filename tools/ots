# Handle CTRL+C which is interpreted to mean stop launch and kill all launched processes
ctrlChandler () {
	out "Caught Ctrl+C -- exiting all launched otsdaq processes..."
	#try to force kill other ots scripts
	echo "KILL_ALL" > $OTSDAQ_STARTOTS_QUIT_FILE
	echo "KILL_ALL ${THIS_HOST}" > $OTSDAQ_STARTOTS_LOCAL_QUIT_FILE
	exit 130   # standard exit code for SIGINT
}
# Install the redirection
trap 'ctrlChandler' SIGINT

# Handle SIGHUP which likely means the ssh connection starting ots was closed and we want to continue with outputs redirected
handler () {
	# exec >/dev/null 2>&1 </dev/null
	exec /tmp/otsActionsHandler2_${OTS_SETUP_TYPE}.$$  2>&1 </dev/null
