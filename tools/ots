#make URL print out a function so that & syntax can be used to run in background (user has immediate terminal access)
printMainURL() {

	#out "printMainURL()"

	if [ $QUIET == 0 ]; then
		sleep 5 #give a little more time before injecting printouts in scrolling printouts
	else
		sleep 4 #give a little time for other StartOTS printouts to occur (so this one is last)
	fi

	if [ $ISREMOTE == 0 ]; then
		echo #empty line
		echo #empty line


		# if port translation map file exists, print out additional URL info
		if [[ -n ${OTS_PORT_TRANSLATION_MAP_FILE:-} && -f ${OTS_PORT_TRANSLATION_MAP_FILE} ]]; then
			out #empty line
			out "Port translation map file found.\n \
If you are accessing otsdaq from outside the local network, you may need port translation.\n\
You can modify the URL host:port translation using this file: at ${Yellow}${OTS_PORT_TRANSLATION_MAP_FILE}${RstClr}"


			# -------------------------------------------------
			#  parse_and_print  –  split each line on "|"
			# -------------------------------------------------

			showTranslation=0

			while IFS= read -r line || [[ -n $line ]]; do
				# -------------------------------------------------
				# Split the line on the literal pipe character.
				# -------------------------------------------------
				IFS='|' read -ra raw_fields <<< "$line"

				# -------------------------------------------------
				# Guard: we need at least three columns.
				# -------------------------------------------------
				(( ${#raw_fields[@]} < 3 )) && continue

				# -------------------------------------------------
				# whitespace **inline** and assign to variables.
				# -------------------------------------------------
				url1=$(printf '%s' "${raw_fields[0]}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
				url2=$(printf '%s' "${raw_fields[1]}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
				url3=$(printf '%s' "${raw_fields[2]}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')


				# remove scheme
				transTmp="${url2#*://}"

				# split host and port
				transHost="${transTmp%%:*}"
				transPort="${transTmp##*:}"

				isThisPortMarker=''
				showThisTranslation=0
				if [[ "${THIS_HOST}" == "$transHost" && "${PORT}" == "$transPort" ]]; then

					if [[ $showTranslation == 0 ]]; then #first found, print header
						echo "Showing current port translation associated with ${THIS_HOST}:${PORT}:"
						echo "--------------------------------------------------"
					fi
					showTranslation=1
					showThisTranslation=1
				fi
				if [[ "${gatewayHostname}" == "$transHost" && "${gatewayPort}" == "$transPort" ]]; then

					if [[ $showTranslation == 0 ]]; then #first found, print header
						echo "Showing current port translation associated with ${gatewayHostname}:${gatewayPort}:"
						echo "--------------------------------------------------"
					fi
					showTranslation=1
					showThisTranslation=1
				fi

				if [[ $showThisTranslation == 1 ]]; then

					isThisPortMarker='*'
					echo -e "$url1 | $url2\t==> $url3 ${isThisPortMarker}"
				fi

				# -------------------------------------------------
				# Print everything on ONE line with labels
				# -------------------------------------------------
				# echo -e "$url1 | $url2\t==> $url3 ${isThisPortMarker}"


			done < "$OTS_PORT_TRANSLATION_MAP_FILE"

			if [[ $showTranslation == 1 ]]; then
				echo "--------------------------------------------------"
			fi
			out #empty line
		fi
	fi

	if [ $MAIN_URL == "unknown_url" ]; then
		if [ $ISREMOTE == 0 ]; then
			out "INFO: No gateway supervisor found for node {${THIS_HOST}}.${RstClr}"
		fi
		exit
	fi


	out "Open the URL below in your Google Chrome or Mozilla Firefox web browser:"
	out "\t(Note: This URL may need to be modified depending on your network configuration)"

	for t in {1..5}
	do
		out "${Green}${Bold}${EUNDERLINE}${MAIN_URL}${RstClr}"

		#echo -e "${Reset}"

		if [ $QUIET == 1 ]; then
			# out "Action handler log is here, e.g.: ${Bold}less -R${RstClr} ${Yellow}${ACTION_HANDLER_LOG}${RstClr} (use less -R to see colorized version)"
			exit
		fi
		sleep 2 #for delay between each printout
	done
	# out "Action handler log is here, e.g.: ${Bold}less -R${RstClr} ${Yellow}${ACTION_HANDLER_LOG}${RstClr} (use less -R to see colorized version)"
}  #end printMainURL


