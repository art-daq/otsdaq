# Function to check disk space of log area, and delete old logs
# Note!! User can prevent data check by export OTSDAQ_LOG_DISK_MINIMUM=0
if [ "x$OTSDAQ_LOG_DISK_MINIMUM" == "x" ];then
	export OTSDAQ_LOG_DISK_MINIMUM=1000000 #1 GB default in KBs
fi
if [ "x$OTSDAQ_LOG_DISK_STALE_THRESHOLD" == "x" ];then
	export OTSDAQ_LOG_DISK_STALE_THRESHOLD=86400 #24 hours default in seconds
fi
OTSDAQ_LOG_DISK_STALE_HOURS=$(( $OTSDAQ_LOG_DISK_STALE_THRESHOLD / 3600 ))
#if min is not 0, print settings
if [ "$OTSDAQ_LOG_DISK_MINIMUM" -ne 0 ]; then
	out "Log file disk min set to ${OTSDAQ_LOG_DISK_MINIMUM} KBs and automatic deletion threshold set to ${OTSDAQ_LOG_DISK_STALE_HOURS} hours."
fi
otsLogDiskCheck() {
	# Note!! User can prevent data check by export OTSDAQ_LOG_DISK_MINIMUM=0
	AVAILABLE_DISK_SPACE=$(df -P "$OTSDAQ_LOG_DIR/" | awk 'NR==2 {print $4}')
	# out "Available disk space in log directory ${OTSDAQ_LOG_DIR}/: ${AVAILABLE_DISK_SPACE} KB..."
	if [ "$AVAILABLE_DISK_SPACE" -lt "$OTSDAQ_LOG_DISK_MINIMUM" ]; then

		#find and delete oldest log files until we are above threshold
		# but only if older than 24 hours

		while [ "$AVAILABLE_DISK_SPACE" -lt "$OTSDAQ_LOG_DISK_MINIMUM" ]; do
			warning "Available disk space in log directory ${OTSDAQ_LOG_DIR}/ is below minimum threshold of ${OTSDAQ_LOG_DISK_MINIMUM} KB. Available: ${AVAILABLE_DISK_SPACE} KB. Deleting old log files..."

			# find oldest matching log file (print mtime as epoch and path), pick oldest
			OLDEST_LOG_FILE=$(find "$OTSDAQ_LOG_DIR/" -type f -name "otsdaq_quiet_run-*.txt" -printf '%T@ %p\n' | sort -n | head -n 1 | awk '{print $2}')
			if [ -z "$OLDEST_LOG_FILE" ]; then
				warning "No more matching log files to delete, but disk space is still below threshold."
				break
			fi

			# get file modification time and compare to 24 hours ago
			FILE_MTIME=$(stat -c %Y "$OLDEST_LOG_FILE" 2>/dev/null || echo 0)
			AGE_THRESHOLD=$(( $(date +%s) - $OTSDAQ_LOG_DISK_STALE_THRESHOLD )) # in seconds

			OTSDAQ_LOG_DISK_STALE_HOURS=$(( $OTSDAQ_LOG_DISK_STALE_THRESHOLD / 3600 ))
			if [ "$FILE_MTIME" -gt "$AGE_THRESHOLD" ]; then
				warning "Oldest log file '$OLDEST_LOG_FILE' is less than ${OTSDAQ_LOG_DISK_STALE_HOURS} hours old; will not delete. Aborting cleanup to avoid removing recent logs."
				break
			fi

			out "Deleting oldest log file (at least ${OTSDAQ_LOG_DISK_STALE_HOURS} hours old): $OLDEST_LOG_FILE"
			rm -f "$OLDEST_LOG_FILE"
			sleep 2 #give time for file system to update and user to respond if needed

			# refresh available disk space for next iteration
			AVAILABLE_DISK_SPACE=$(df -P "$OTSDAQ_LOG_DIR/" | awk 'NR==2 {print $4}')
		done

		if [ "$AVAILABLE_DISK_SPACE" -ge "$OTSDAQ_LOG_DISK_MINIMUM" ]; then
			info "Disk space in log directory ${OTSDAQ_LOG_DIR}/ is now above minimum threshold. Available: ${AVAILABLE_DISK_SPACE} KB."
		else
			warning "Disk space in log directory ${OTSDAQ_LOG_DIR}/ is still below minimum threshold of ${OTSDAQ_LOG_DISK_MINIMUM} KB after attempt to delete old logs. Available: ${AVAILABLE_DISK_SPACE} KB."
			sleep 20 #to avoid rapid looping of error message
		fi
	fi
} #end otsLogDiskCheck


#########################################################
#########################################################
# Function to check disk space of data area, and delete old data files
# Note!! User can prevent data check by export OTSDAQ_DATA_DISK_MINIMUM=0
if [ "x$OTSDAQ_DATA_DISK_MINIMUM" == "x" ];then
	export OTSDAQ_DATA_DISK_MINIMUM=0 #0 to disable or #100000000 for 100 GB default in KBs
fi
if [ "x$OTSDAQ_DATA_DISK_STALE_THRESHOLD" == "x" ];then
	export OTSDAQ_DATA_DISK_STALE_THRESHOLD=31536000 #1 year default in seconds
fi
OTSDAQ_DATA_DISK_STALE_HOURS=$(( $OTSDAQ_DATA_DISK_STALE_THRESHOLD / 3600 ))
#if min is not 0, print settings
if [ "$OTSDAQ_DATA_DISK_MINIMUM" -ne 0 ]; then
	out "Data file disk min set to ${OTSDAQ_DATA_DISK_MINIMUM} KBs and automatic deletion threshold set to ${OTSDAQ_DATA_DISK_STALE_HOURS} hours."
fi
otsDataDiskCheck() {
	# Note!! User can prevent data check by export OTSDAQ_DATA_DISK_MINIMUM=0
	AVAILABLE_DISK_SPACE=$(df -P "$OTSDAQ_DATA/" | awk 'NR==2 {print $4}')
	if [ "$AVAILABLE_DISK_SPACE" -lt "$OTSDAQ_DATA_DISK_MINIMUM" ]; then
		#find and delete oldest data files until we are above threshold
		# but only if older than stale threshold

		while [ "$AVAILABLE_DISK_SPACE" -lt "$OTSDAQ_DATA_DISK_MINIMUM" ]; do
			warning "Available disk space in data directory ${OTSDAQ_DATA}/ is below minimum threshold of ${OTSDAQ_DATA_DISK_MINIMUM} KB. Available: ${AVAILABLE_DISK_SPACE} KB. Deleting old data files..."
			# find oldest matching log file (print mtime as epoch and path), pick oldest
			# Recursively find oldest matching data file (follow symlinks, handle spaces)
			OLDEST_DATA_FILE=""
			oldest_time=0
			while IFS= read -r -d '' file; do
				mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
				if [ -z "$OLDEST_DATA_FILE" ] || [ "$mtime" -lt "$oldest_time" ]; then
					OLDEST_DATA_FILE="$file"
					oldest_time=$mtime
				fi
			done < <(find -L "$OTSDAQ_DATA" -type f \( -name '*.bin' -o -name '*.dat' -o -name '*.txt' -o -name '*.root' \) -print0)
			if [ -z "$OLDEST_DATA_FILE" ]; then
				warning "No more matching data files to delete, but disk space is still below threshold."
				break
			fi

			# get file modification time and compare to stale threshold
			FILE_MTIME=$(stat -c %Y "$OLDEST_DATA_FILE" 2>/dev/null || echo 0)
			AGE_THRESHOLD=$(( $(date +%s) - $OTSDAQ_DATA_DISK_STALE_THRESHOLD )) # in seconds

			OTSDAQ_DATA_DISK_STALE_HOURS=$(( $OTSDAQ_DATA_DISK_STALE_THRESHOLD / 3600 ))

			if [ "$FILE_MTIME" -gt "$AGE_THRESHOLD" ]; then
				warning "Oldest data file '$OLDEST_DATA_FILE' is less than ${OTSDAQ_DATA_DISK_STALE_HOURS} hours old; will not delete. Aborting cleanup to avoid removing recent data files."
				break
			fi

			out "Deleting oldest data file (at least ${OTSDAQ_DATA_DISK_STALE_HOURS} hours old): $OLDEST_DATA_FILE"
			rm -f "$OLDEST_DATA_FILE"
			sleep 2 #give time for file system to update and user to respond if needed

			# refresh available disk space for next iteration
			AVAILABLE_DISK_SPACE=$(df -P "$OTSDAQ_DATA/" | awk 'NR==2 {print $4}')
		done

		if [ "$AVAILABLE_DISK_SPACE" -ge "$OTSDAQ_DATA_DISK_MINIMUM" ]; then
			info "Disk space in data directory ${OTSDAQ_DATA}/ is now above minimum threshold. Available: ${AVAILABLE_DISK_SPACE} KB."
		else
			warning "Disk space in data directory ${OTSDAQ_DATA}/ is still below minimum threshold of ${OTSDAQ_DATA_DISK_MINIMUM} KB after attempt to delete old data files. Available: ${AVAILABLE_DISK_SPACE} KB."
			sleep 20 #to avoid rapid looping of error message
		fi
	fi
} #end otsDataDiskCheck

#########################################################
#########################################################
# Function to handle ots actions and commands from local XDAQ Contexts
#  such as rebuild, restart, exit, etc.
# Action Handler Logs are written to tmp/otsActionsHandler_${OTS_SETUP_TYPE}.$$
# Log rollover is also handled.
ACTION_HANDLER_LOG="tmp/otsActionsHandler_${OTS_SETUP_TYPE}-${THIS_HOST}.$$"
otsActionHandler() {

	bpid=$BASHPID
	info "Starting action handler on ${THIS_HOST}... (pid = ${bpid})"

	# Trap specific signals and call the exit handler
	for sig in {1..3}; do #1=SIGHUP, 2=SIGINT, 3=SIGQUIT, was ..31 (avoid ctrl+Z killing script)
		trap "handleExitSignal $sig" $sig 2>/dev/null
	done

	if [[ ($ISCONFIG == 1) || ($ISMACROMAKER == 1) || ("${THIS_HOST}" == "${gatewayHostname}") ]]; then
		out "The script, on ${THIS_HOST}, is the gateway ots script, so it will drive the exit of ots scripts running on other hosts."

		if [ $REMOTELAUNCH == 1 ]; then #only kill other ots scripts if remote launch was enabled
			echo "EXIT_LOOP" > $OTSDAQ_STARTOTS_QUIT_FILE
		fi

		echo "EXIT_LOOP ${THIS_HOST}" > $OTSDAQ_STARTOTS_LOCAL_QUIT_FILE

		#time for other stale StartOTS to quit
		sleep 5

		#clear files initially
		echo "0" > $OTSDAQ_STARTOTS_ACTION_FILE
		echo "0" > $OTSDAQ_STARTOTS_QUIT_FILE
		echo "0" > $OTSDAQ_STARTOTS_LOCAL_QUIT_FILE
	else
		sleep 10 #non gateways sleep for a while, to give time to quit stale scripts

		#clear files initially
		echo "0" > $OTSDAQ_STARTOTS_ACTION_FILE
		echo "0" > $OTSDAQ_STARTOTS_LOCAL_QUIT_FILE
	fi

	FIRST_TIME=1 #to enable url printouts
	DO_LOG_ROLLOVER=0

	out
	out "Process information for PID ${bpid}: ps -aux | grep ${bpid}"
	while IFS= read -r psline; do
		out "$psline"
	done < <(ps aux | grep "${bpid}")
	out

	#listen for file commands
	while true; do
		#In OTSDAQ_STARTOTS_ACTION_FILE
		#0 is the default. No action is taken
		#REBUILD_OTS will rebuild otsdaq
		#Reset_MPI will reboot artdaq MPI runs
		#EXIT_LOOP will exit ots action loop
		#KILL_ALL will kill all and exit ots action loop
		#if cmd file is missing, exit StartOTS loop


		#check for processes getting killed
		i=0
		for pid in "${ContextPIDArray[@]}"
		do
			if [ ${ContextPIDIsAliveArray[$i]} == 1 ]; then
				if kill -0 "$pid" 2>/dev/null; then
					ContextPIDIsAliveArray[$i]=1 #do nothing, PID $pid is still alive."
				else
					out "Context '${ContextPIDNameArray[$i]}' PID $pid is not alive."
					ContextPIDIsAliveArray[$i]=0
				fi
			fi
			i=$(( $i + 1 ))
		done



		OTSDAQ_STARTOTS_ACTION="$(cat ${OTSDAQ_STARTOTS_ACTION_FILE})"
		OTSDAQ_STARTOTS_QUIT="$(cat ${OTSDAQ_STARTOTS_QUIT_FILE})"
		OTSDAQ_STARTOTS_LOCAL_QUIT="$(cat ${OTSDAQ_STARTOTS_LOCAL_QUIT_FILE})"

		echo "0" > $OTSDAQ_STARTOTS_ACTION_FILE #clear the command in the file; it has been responded to

		if [ "$OTSDAQ_REFRESH_SSH" == "1" ]; then
			if declare -F otsUserSshTunnels > /dev/null; then
				otsUserSshTunnels #show output in case of weird repetitive tunnel situations from user, user can always hide output in the function (recommended when not remaking tunnel)
			fi
		fi

		#out "message loop command ${OTSDAQ_STARTOTS_ACTION} ${OTSDAQ_STARTOTS_QUIT} ${OTSDAQ_STARTOTS_LOCAL_QUIT} "

		if [ "$OTSDAQ_STARTOTS_ACTION" == "REBUILD_OTS" ]; then


			out " "
			out "self-pid=${BASHPID}: Rebuilding..."
			out " "
			#echo "1" > mrbresult.num; mrb b > otsdaq_startots_mrbreport.txt && echo "0" > mrbresult.num
			out " "
			#grep -A 1 -B 1 "INFO: Stage build successful." otsdaq_startots_mrbreport.txt
			out " "
			sleep 5

		elif [ "$OTSDAQ_STARTOTS_ACTION" == "OTS_APP_SHUTDOWN" ]; then


			out " "
			out "self-pid=${BASHPID}: Shutting down non-gateway contexts..."
			out " "

			#kill all non-Gateway context processes
			killprocs nongateway

		elif [ "$OTSDAQ_STARTOTS_ACTION" == "OTS_APP_STARTUP" ]; then


			out " "
			out "self-pid=${BASHPID}: Starting up non-gateway contexts..."
			out " "

			#prevent remote ssh launches
			TMP_REMOTELAUNCH=$REMOTELAUNCH
			REMOTELAUNCH=0
			launchOTS nongateway #launch all non-gateway apps
			REMOTELAUNCH=$TMP_REMOTELAUNCH

		elif [ "$OTSDAQ_STARTOTS_ACTION" == "LAUNCH_WIZ" ]; then


			out "self-pid=${BASHPID}: Starting otsdaq Wiz mode for host {${THIS_HOST}}..."

			killprocs

			launchOTSWiz

			#sleep 1 #so that the terminal comes back after the printouts in quiet mode

			FIRST_TIME=1 #re-enable printouts for launch ots, in case of context changes

		elif [ "$OTSDAQ_STARTOTS_ACTION" == "LAUNCH_OTS" ]; then

			out "self-pid=${BASHPID}: Starting otsdaq in normal mode for host {${THIS_HOST}}..."

			killprocs

			launchOTS

			#wait #so that the terminal comes back after the printouts in quiet mode

		elif [ "$OTSDAQ_STARTOTS_ACTION" == "FLATTEN_TO_SYSTEM_ALIASES" ]; then

			out "self-pid=${BASHPID}: Removing unused tables and groups based on active System Aliases..."
			out "otsdaq_flatten_system_aliases 0"


			if [ $QUIET == 1 ]; then

				if [ $BACKUPLOGS == 1 ]; then
					DATESTRING=`date +'%s'`
					out "     Backing up logfile to *** ${OTSDAQ_LOG_DIR}/otsdaq_quiet_run-flatten-${THIS_HOST}.${DATESTRING}.txt ***"
					mv ${OTSDAQ_LOG_DIR}/otsdaq_quiet_run-flatten-${THIS_HOST}.txt ${OTSDAQ_LOG_DIR}/otsdaq_quiet_run-flatten-${THIS_HOST}.${DATESTRING}.txt
				fi

				out "${Red}${Bold}Quiet mode${RstClr}. '${Bold}Flattening${RstClr}' logging to ${OTSDAQ_LOG_DIR}/otsdaq_quiet_run-flatten-${THIS_HOST}.txt ***  "
				otsdaq_flatten_system_aliases 0 &> ${OTSDAQ_LOG_DIR}/otsdaq_quiet_run-flatten-${THIS_HOST}.txt &
			else
				otsdaq_flatten_system_aliases 0 &
			fi

		elif [[ "$OTSDAQ_STARTOTS_ACTION" == "EXIT_LOOP" || "$OTSDAQ_STARTOTS_QUIT" == "EXIT_LOOP" || "$OTSDAQ_STARTOTS_LOCAL_QUIT" == "EXIT_LOOP ${THIS_HOST}" ]]; then

			#only exit action loop
			out "self-pid=${BASHPID}: Exit of (stale) ots... Action:${OTSDAQ_STARTOTS_ACTION}-Quit:${OTSDAQ_STARTOTS_QUIT}-Local:${OTSDAQ_STARTOTS_LOCAL_QUIT}"

			exit

		elif [[ "$OTSDAQ_STARTOTS_ACTION" == "KILL_ALL" || "$OTSDAQ_STARTOTS_QUIT" == "KILL_ALL" || "$OTSDAQ_STARTOTS_LOCAL_QUIT" == "KILL_ALL ${THIS_HOST}" ]]; then

			#kill all and exit action loop
			out "self-pid=${BASHPID}: Exit of (stale) ots... Action:${OTSDAQ_STARTOTS_ACTION}-Quit:${OTSDAQ_STARTOTS_QUIT}-Local:${OTSDAQ_STARTOTS_LOCAL_QUIT}"

			killprocs

			if [ $ISREMOTE == 1 ]; then
				out "Done killing (stale) processes"
			fi

			exit

		elif [[ $OTSDAQ_STARTOTS_ACTION == LAUNCH_INSTANCE* ]]; then

			info "self-pid=${BASHPID}: Launching remote ots instance $OTSDAQ_STARTOTS_ACTION"

			# Set Internal Field Separator to ";"
			IFS=';'

			# Read the string into an array
			read -ra params <<< "$OTSDAQ_STARTOTS_ACTION"
			# Print each parameter
			cnt=0
			for param in "${params[@]}"; do
				# out "param[$cnt] = $param"

				if [ $cnt == 1 ]; then
					inst_user=$param
				elif [ $cnt == 2 ]; then
					inst_host=$param
				elif [ $cnt == 3 ]; then
					inst_path=$param
				elif [ $cnt == 4 ]; then
					inst_mode=$param
				elif [ $cnt == 5 ]; then
					inst_type=$param
				elif [ $cnt == 6 ]; then
					inst_data=$param
				fi
				cnt=$(( $cnt + 1 ))
			done

			if [ $cnt != 7 ]; then
				error "Invalid parameters received, must be 7 (received ${cnt})."
			else
				out "inst_user = $inst_user"
				out "inst_host = $inst_host"
				out "inst_path = $inst_path"
				out "inst_mode = $inst_mode"
				out "inst_type = $inst_type"
				out "inst_data = $inst_data"


				out "\tRemote launch of ots instance processes on host {${inst_host}}."
				out "\t\tssh ${inst_user}@${inst_host} SCRIPT_DIR/ots_remote_instance_start ${inst_host} ${inst_path} ${inst_mode} ${inst_type}"

				# first kill existing for immediate gratification to user (so not confused by existing instance status)
				ssh -K ${inst_user}@${inst_host} "echo \"KILL_ALL\" > ${inst_data}/ServiceData/StartOTS_action_quit.cmd"

				# launch ssh remote start (attempt twice)
				ssh -K ${inst_user}@${inst_host} ${SCRIPT_DIR}/ots_remote_instance_start ${inst_host} ${inst_path} ${inst_mode} ${inst_type} || ssh -K ${inst_host} ${SCRIPT_DIR}/ots_remote_instance_start ${inst_host} ${inst_path} ${inst_mode} ${inst_type} || out "${Red}${REV} ***************** {${inst_host}} Remote start failed (check local permissions and remote installation)! ********************* ${RstClr}" &
			fi

		elif [[ "$OTSDAQ_STARTOTS_ACTION" == LOG_ROLLOVER* ]]; then

			info "self-pid=${BASHPID}: Rolling over log files $OTSDAQ_STARTOTS_ACTION"

			# Set Internal Field Separator to ";"
			IFS=';'

			# Read the string into an array
			read -ra params <<< "$OTSDAQ_STARTOTS_ACTION"
			# Print each parameter
			cnt=0
			log_label=""
			for param in "${params[@]}"; do
				# out "param[$cnt] = $param"

				if [ $cnt == 1 ]; then
					log_label="-$param"
				fi
				cnt=$(( $cnt + 1 ))
			done

			if [ $cnt != 2 ]; then
				error "Invalid parameters received, must be 2 (received ${cnt})."
			else
				out "log_label = $log_label"

				DO_LOG_ROLLOVER=1
			fi

		elif [[ "${OTSDAQ_STARTOTS_ACTION:-"0"}" != "0"  || "${OTSDAQ_STARTOTS_QUIT:-"0"}" != "0" ]]; then

			error "self-pid=${BASHPID}: Exiting ots script.. Unrecognized command !=0 in Action:${OTSDAQ_STARTOTS_ACTION}-Quit:${OTSDAQ_STARTOTS_QUIT}-Local:${OTSDAQ_STARTOTS_LOCAL_QUIT}"
			exit

		fi

		sleep 1
		# Note!! User can prevent data check with export OTSDAQ_DATA_DISK_MINIMUM=0
		otsDataDiskCheck

		#manage log file rollover with $OTS_LOG_ROLLOVER or ots commands
		if [[ "x$OTS_LOG_ROLLOVER" != "x" || $DO_LOG_ROLLOVER == 1 ]]; then

			#check disk space before rollover
			# Note!! User can prevent data check with export OTSDAQ_LOG_DISK_MINIMUM=0
			otsLogDiskCheck

			#handle non-gateway logs on this host
			i=0
			for contextPID in "${ContextPIDArray[@]}"
			do
				if [[ ${xdaqHost[$i]} != ${THIS_HOST} ]]; then
					i=$(( $i + 1 ))
					continue
				fi

				logFileSize=$(stat -c %s "${OTSDAQ_LOG_DIR}/${xdaqLogFilename[$i]}")
				if [ "x$logFileSize" == "x" ]; then
					logFileSize=0
					# out "File empty"
				fi
				# out "Found Non-gateway process ID ${contextPID} -h ${xdaqHost[$i]} -p ${xdaqPort[$i]} > ${xdaqLogFilename[$i]} size=${logFileSize}"

				# if log file > 100MB, export OTS_LOG_ROLLOVER=100000000
				if [[ $logFileSize -gt $OTS_LOG_ROLLOVER || $DO_LOG_ROLLOVER == 1 ]]; then
					DATESTRING=`date +'%s'`
					out "self-pid=${BASHPID}: Found Non-gateway process ID ${contextPID} -h ${xdaqHost[$i]} -p ${xdaqPort[$i]} > ${xdaqLogFilename[$i]} size=${logFileSize}"
					tmpLogFilename=$xdaqLogFilename[$i]
					xdaqLogFilename[$i]="otsdaq_quiet_run-${xdaqHost[$i]}-${xdaqPort[$i]}${log_label}-${DATESTRING}.txt"
					out "${Red}${Bold}Redirecting${RstClr} ${Bold}Non-gateway${RstClr}' process ID ${contextPID} -h ${xdaqHost[$i]} -p ${xdaqPort[$i]} > ${Yellow}${OTSDAQ_LOG_DIR}/${xdaqLogFilename[$i]}${RstClr}"

					#from https://github.com/jerome-pouiller/reredirect/
					# reredirect overwrites the file, so do not attempt to create in advance
					# echo "Redirecting Non-gateway process ID ${contextPID} -h ${xdaqHost[$i]} -p ${xdaqPort[$i]} > ${OTSDAQ_LOG_DIR}/${tmpLogFilename} size=${logFileSize}" >> ${OTSDAQ_LOG_DIR}/${xdaqLogFilename[$i]}
					# echo "...to this file: ${OTSDAQ_LOG_DIR}/${xdaqLogFilename[$i]}" >> ${OTSDAQ_LOG_DIR}/${xdaqLogFilename[$i]}

					REDIRECT_FAILED=1
					MAX_RETRIES=20
					RETRY_COUNT=0
					while [ $REDIRECT_FAILED -ne 0 ] && [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
						out "Attempt $((RETRY_COUNT + 1)) to redirect process ID ${contextPID} on host ${xdaqHost[$i]} port ${xdaqPort[$i]}..."
						timeout 2s reredirect -N -m "${OTSDAQ_LOG_DIR}/${xdaqLogFilename[$i]}" ${contextPID} && REDIRECT_FAILED=0 || REDIRECT_FAILED=1

						if [ $REDIRECT_FAILED -ne 0 ]; then
							error "Redirect failed on attempt $((RETRY_COUNT + 1)). Retrying..."
							RETRY_COUNT=$((RETRY_COUNT + 1))
							# sleep 1  # Optional delay before retrying
						fi
					done

					if [ $REDIRECT_FAILED == 1 ]; then
						out "To manually retry: reredirect -N -m "${OTSDAQ_LOG_DIR}/${xdaqLogFilename[$i]}" ${contextPID}"
						$xdaqLogFilename[$i]=$tmpLogFilename
						error "Redirect failed!.. Reverting to ${OTSDAQ_LOG_DIR}/${xdaqLogFilename[$i]}"
					else
						echo "Redirecting Non-gateway process ID ${contextPID} -h ${xdaqHost[$i]} -p ${xdaqPort[$i]} > ${OTSDAQ_LOG_DIR}/${tmpLogFilename} size=${logFileSize}" >> ${OTSDAQ_LOG_DIR}/${tmpLogFilename}
						echo "Redirected to Non-gateway process ID ${contextPID} -h ${xdaqHost[$i]} -p ${xdaqPort[$i]} > ${OTSDAQ_LOG_DIR}/${xdaqLogFilename[$i]}" >> ${OTSDAQ_LOG_DIR}/${tmpLogFilename}
						info "self-pid=${BASHPID}: Completed log rollover of Non-gateway process ID ${contextPID} -h ${xdaqHost[$i]} -p ${xdaqPort[$i]}"
					fi
				fi
				i=$(( $i + 1 ))
			done #end handle non-gateway logs on this host

			#handle gateway logs on this host
			if [[ -v GATEWAY_PID ]]; then
				logFileSize=$(stat -c %s "${OTSDAQ_LOG_DIR}/${gatewayLogFilename}")
				if [ "x$logFileSize" == "x" ]; then
					logFileSize=0
					# out "File empty"
				fi
				# out "Found Gateway process ID ${GATEWAY_PID} -h ${gatewayHostname} -p ${gatewayPort} > ${gatewayLogFilename} size=${logFileSize}"

				# if log file > 100MB, export OTS_LOG_ROLLOVER=100000000
				if [[ $logFileSize -gt $OTS_LOG_ROLLOVER || $DO_LOG_ROLLOVER == 1 ]]; then
					DATESTRING=`date +'%s'`
					out "self-pid=${BASHPID}: Found Gateway process ID ${GATEWAY_PID} -h ${gatewayHostname} -p ${gatewayPort} > ${gatewayLogFilename} size=${logFileSize}"
					tmpLogFilename=$gatewayLogFilename
					gatewayLogFilename="otsdaq_quiet_run-gateway-${gatewayHostname}-${gatewayPort}${log_label}-${DATESTRING}.txt"
					out "${Red}${Bold}Redirecting${RstClr} ${Bold}Gateway${RstClr}' process ID ${GATEWAY_PID} -h ${gatewayHostname} -p ${gatewayPort} > ${Yellow}${OTSDAQ_LOG_DIR}/${gatewayLogFilename}${RstClr}"

					#from https://github.com/jerome-pouiller/reredirect/
					# reredirect overwrites the file, so do not attempt to create in advance
					# echo "Redirecting Gateway process ID ${GATEWAY_PID} -h ${gatewayHostname} -p ${gatewayPort} > ${OTSDAQ_LOG_DIR}/${tmpLogFilename} size=${logFileSize}" >> ${OTSDAQ_LOG_DIR}/${gatewayLogFilename}
					# echo "...to this file: ${OTSDAQ_LOG_DIR}/${gatewayLogFilename}" >> ${OTSDAQ_LOG_DIR}/${gatewayLogFilename}

					REDIRECT_FAILED=1
					MAX_RETRIES=20
					RETRY_COUNT=0
					while [ $REDIRECT_FAILED -ne 0 ] && [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
						out "Attempt $((RETRY_COUNT + 1)) to redirect process ID ${GATEWAY_PID} on host ${gatewayHostname} port ${gatewayPort}..."
						timeout 2s reredirect -N -m "${OTSDAQ_LOG_DIR}/${gatewayLogFilename}" ${GATEWAY_PID} && REDIRECT_FAILED=0 || REDIRECT_FAILED=1

						if [ $REDIRECT_FAILED -ne 0 ]; then
							error "Redirect failed on attempt $((RETRY_COUNT + 1)). Retrying..."
							RETRY_COUNT=$((RETRY_COUNT + 1))
							# sleep 1  # Optional delay before retrying
						fi
					done

					if [ $REDIRECT_FAILED == 1 ]; then
						out "To manually retry: reredirect -N -m "${OTSDAQ_LOG_DIR}/${gatewayLogFilename}" ${GATEWAY_PID}"
						gatewayLogFilename=$tmpLogFilename
						error "Redirect failed!.. Reverting to ${OTSDAQ_LOG_DIR}/${gatewayLogFilename}"
					else
						echo "Redirecting Gateway process ID ${GATEWAY_PID} -h ${gatewayHostname} -p ${gatewayPort} > ${OTSDAQ_LOG_DIR}/${tmpLogFilename} size=${logFileSize}" >> ${OTSDAQ_LOG_DIR}/${tmpLogFilename}
						echo "Redirected Gateway process ID ${GATEWAY_PID} -h ${gatewayHostname} -p ${gatewayPort} > ${OTSDAQ_LOG_DIR}/${gatewayLogFilename}" >> ${OTSDAQ_LOG_DIR}/${tmpLogFilename}
						info "self-pid=${BASHPID}: Completed log rollover of Gateway process ID ${GATEWAY_PID} -h ${gatewayHostname} -p ${gatewayPort}"
					fi
				fi
			fi #end handle gateway logs on this host

			#handle mf forwarder 'otsConsoleFwd' logs on this host
			if [[ -v MF_FWD_PID ]]; then
				logFileSize=$(stat -c %s "${OTSDAQ_LOG_DIR}/otsdaq_quiet_run-mf-${THIS_HOST}.txt")
				if [ "x$logFileSize" == "x" ]; then
					logFileSize=0
					# out "File empty"
				fi
				# out "Found otsConsoleFwd process ID ${MF_FWD_PID} > otsdaq_quiet_run-mf-${THIS_HOST}.txt size=${logFileSize}"

				# if log file > 100MB, export OTS_LOG_ROLLOVER=100000000
				if [[ $logFileSize -gt $OTS_LOG_ROLLOVER || $DO_LOG_ROLLOVER == 1 ]]; then
					DATESTRING=`date +'%s'`
					out "self-pid=${BASHPID}: Found otsConsoleFwd process ID ${MF_FWD_PID} > otsdaq_quiet_run-mf-${THIS_HOST}.txt size=${logFileSize}"
					tmpLogFilename="otsdaq_quiet_run-mf-${THIS_HOST}.txt"
					mfLogFilename="otsdaq_quiet_run-mf-${THIS_HOST}${log_label}-${DATESTRING}.txt"
					out "${Red}${Bold}Redirecting${RstClr} ${Bold}otsConsoleFwd${RstClr}' process ID ${MF_FWD_PID} > ${Yellow}${OTSDAQ_LOG_DIR}/${mfLogFilename}${RstClr}"

					#from https://github.com/jerome-pouiller/reredirect/
					# reredirect overwrites the file, so do not attempt to create in advance
					# echo "Redirecting otsConsoleFwd process ID ${MF_FWD_PID} > ${OTSDAQ_LOG_DIR}/${tmpLogFilename} size=${logFileSize}" >> ${OTSDAQ_LOG_DIR}/${mfLogFilename}
					# echo "...to this file: ${OTSDAQ_LOG_DIR}/${mfLogFilename}" >> ${OTSDAQ_LOG_DIR}/${mfLogFilename}

					REDIRECT_FAILED=1
					MAX_RETRIES=20
					RETRY_COUNT=0
					while [ $REDIRECT_FAILED -ne 0 ] && [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
						out "Attempt $((RETRY_COUNT + 1)) to redirect process ID ${MF_FWD_PID} on host ${THIS_HOST}..."
						timeout 2s reredirect -N -m "${OTSDAQ_LOG_DIR}/${mfLogFilename}" ${MF_FWD_PID} && REDIRECT_FAILED=0 || REDIRECT_FAILED=1

						if [ $REDIRECT_FAILED -ne 0 ]; then
							error "Redirect failed on attempt $((RETRY_COUNT + 1)). Retrying..."
							RETRY_COUNT=$((RETRY_COUNT + 1))
							# sleep 1  # Optional delay before retrying
						fi
					done

					if [ $REDIRECT_FAILED == 1 ]; then
						out "To manually retry: reredirect -N -m "${OTSDAQ_LOG_DIR}/${mfLogFilename}" ${MF_FWD_PID}"
						mfLogFilename=$tmpLogFilename
						error "Redirect failed!.. Reverting to ${OTSDAQ_LOG_DIR}/${mfLogFilename}"
					else
						echo "Redirecting otsConsoleFwd process ID ${MF_FWD_PID} > ${OTSDAQ_LOG_DIR}/${tmpLogFilename} size=${logFileSize}" >> ${OTSDAQ_LOG_DIR}/${tmpLogFilename}
						echo "Redirected otsConsoleFwd process ID ${MF_FWD_PID} > ${OTSDAQ_LOG_DIR}/${mfLogFilename}" >> ${OTSDAQ_LOG_DIR}/${tmpLogFilename}
						info "self-pid=${BASHPID}: Completed log rollover of otsConsoleFwd process ID ${MF_FWD_PID}"
					fi
				fi
			fi #end handle mf forwarder 'otsConsoleFwd' logs on this host


		fi

		DO_LOG_ROLLOVER=0 #clear do rollover command
	done


} #end otsActionHandler
export -f otsActionHandler

#functions have been declared
#now launch things


# Handle log deletion options (-lx, -llx, -lllx): validate, prompt, and run deletion only
if [ $ISDELETEOLDLOGS == 1 ] || [ $ISDELETEOLDLOGS_ARTDAQ == 1 ] || [ $ISDELETEOLDLOGS_LOCAL == 1 ]; then
	_logdelete_validate_and_prompt || exit 1
fi

if [ $ISDELETEOLDLOGS_ARTDAQ == 1 ]; then
	# -llx: delete locally + on ARTDAQ hosts (no log find display)
	_logdelete_delete_old_logs
	# Also delete on remote ARTDAQ hosts via SSH
	out
	out "${Bold}${Cyan}Deleting old logs on remote ARTDAQ hosts...${RstClr}"
	_artdaq_ranks_file=$(find -L "${USER_DATA}/ARTDAQConfigurations/run_records" -maxdepth 2 -name 'ranks.txt' -type f 2>/dev/null \
		| sort -t/ -k$(echo "${USER_DATA}/ARTDAQConfigurations/run_records/" | tr -cd '/' | wc -c) -n \
		| tail -1)
	if [ -n "$_artdaq_ranks_file" ]; then
		declare -A _del_seen_hosts
		_del_seen_hosts["${THIS_HOST}"]=1
		while read -r _del_line; do
			[[ -z "$_del_line" ]] && continue
			[[ "$_del_line" == host* ]] && continue
			_del_host=$(echo "$_del_line" | awk '{print $1}')
			[[ -z "$_del_host" ]] && continue
			[ -n "${_del_seen_hosts[$_del_host]+x}" ] && continue
			_del_host_stripped="${_del_host/-data/}"
			_del_host_stripped="${_del_host_stripped/-ipmi/}"
			if [[ "$_del_host_stripped" == "${THIS_HOST}" || "$_del_host_stripped" == "${THIS_HOST}."* ]]; then
				_del_seen_hosts["$_del_host"]=1
				continue
			fi
			_del_seen_hosts["$_del_host"]=1
			out "  ${IBlack}[${_del_host}] Deleting via SSH...${RstClr}"
			_del_dryrun_arg=""
			if [ "$DELETE_LOGS_DRYRUN" -eq 1 ]; then _del_dryrun_arg="dryrun"; fi
			_del_ssh_cmd="{ cd '${OTS_SETUP_DIR}/otsdaq-mu2e-config' && source ./Fast_ots_setup.sh '${OTS_SETUP_TYPE}' logsdelete ${DELETE_LOGS_TIME_INT} ${DELETE_LOGS_TIME_UNIT} ${_del_dryrun_arg}; } 2>&1"
			_del_ssh_output=$(ssh -K -o ConnectTimeout=10 -o BatchMode=yes "$_del_host" \
				"$_del_ssh_cmd" 2>/dev/null)
			_del_ssh_rc=$?
			if [ $_del_ssh_rc -ne 0 ]; then
				_del_ssh_output=$(ssh -K -o ConnectTimeout=10 -o BatchMode=yes "${_del_host/-data/}" \
					"$_del_ssh_cmd" 2>/dev/null)
				_del_ssh_rc=$?
			fi
			if [ $_del_ssh_rc -ne 0 ]; then
				out "  ${Red}[${_del_host}] SSH delete failed. Skipping.${RstClr}"
			else
				# Parse remote output: show only deletion-relevant lines
				while IFS= read -r _del_rline; do
					_del_clean=$(echo "$_del_rline" | sed 's/\x1b\[[0-9;]*m//g')
					# Strip TRACE prefix (everything up to and including "|" followed by whitespace)
					if [[ "$_del_clean" == *" |"* ]]; then
						_del_clean="${_del_clean##* |}"
					fi
					# Trim leading whitespace/tabs
					_del_clean="${_del_clean#"${_del_clean%%[![:space:]]*}"}"
					# Show lines that are deletion-related
					if [[ "$_del_clean" == DELETE* ]] || \
					   [[ "$_del_clean" == RMDIR* ]] || \
					   [[ "$_del_clean" == KEEP* ]] || \
					   [[ "$_del_clean" == *"files to delete"* ]] || \
					   [[ "$_del_clean" == *"Total files to delete"* ]] || \
					   [[ "$_del_clean" == *"not shown"* ]] || \
					   [[ "$_del_clean" == *"DRY RUN"* ]] || \
					   [[ "$_del_clean" == *"No log files older than"* ]] || \
					   [[ "$_del_clean" == *"older than"*"to delete"* ]] || \
					   [[ "$_del_clean" == *"empty subdirectories"* ]] || \
					   [[ "$_del_clean" == "Done." ]]; then
						out "    [${_del_host}] ${_del_clean}"
					fi
				done <<< "$_del_ssh_output"
			fi
		done < "$_artdaq_ranks_file"
		unset _del_seen_hosts _del_host _del_host_stripped _del_line _del_ssh_cmd _artdaq_ranks_file
		unset _del_ssh_output _del_ssh_rc _del_rline _del_clean
	else
		out "  ${IBlack}No ranks.txt found. Skipping remote ARTDAQ host deletion.${RstClr}"
	fi
	exit
fi

if [ $ISDELETEOLDLOGS_LOCAL == 1 ]; then
	# -lllx: delete locally only (no log find display)
	_logdelete_delete_old_logs
	exit
fi

if [ $ISDELETEOLDLOGS == 1 ]; then
	# -lx: delete locally (with ARTDAQ rank handling via -llx logic) + on each remote context host
	# First, do local + ARTDAQ hosts (same as -llx)
	_logdelete_delete_old_logs
	DELETE_LOGS_LOCAL_COUNT=$DELETE_LOGS_LAST_COUNT
	DELETE_LOGS_GRAND_TOTAL=$(( DELETE_LOGS_GRAND_TOTAL + DELETE_LOGS_LAST_COUNT ))
	DELETE_LOGS_REMOTE_COUNT=0

	# Find ARTDAQ hosts from ranks.txt and delete on them too
	out
	out "${Bold}${Cyan}Deleting old logs on ARTDAQ hosts (from ranks.txt)...${RstClr}"
	_artdaq_ranks_file=$(find -L "${USER_DATA}/ARTDAQConfigurations/run_records" -maxdepth 2 -name 'ranks.txt' -type f 2>/dev/null \
		| sort -t/ -k$(echo "${USER_DATA}/ARTDAQConfigurations/run_records/" | tr -cd '/' | wc -c) -n \
		| tail -1)
	if [ -n "$_artdaq_ranks_file" ]; then
		declare -A _del_seen_hosts
		_del_seen_hosts["${THIS_HOST}"]=1
		while read -r _del_line; do
			[[ -z "$_del_line" ]] && continue
			[[ "$_del_line" == host* ]] && continue
			_del_host=$(echo "$_del_line" | awk '{print $1}')
			[[ -z "$_del_host" ]] && continue
			[ -n "${_del_seen_hosts[$_del_host]+x}" ] && continue
			_del_host_stripped="${_del_host/-data/}"
			_del_host_stripped="${_del_host_stripped/-ipmi/}"
			if [[ "$_del_host_stripped" == "${THIS_HOST}" || "$_del_host_stripped" == "${THIS_HOST}."* ]]; then
				_del_seen_hosts["$_del_host"]=1
				continue
			fi
			_del_seen_hosts["$_del_host"]=1
			_del_dryrun_arg=""
			if [ "$DELETE_LOGS_DRYRUN" -eq 1 ]; then _del_dryrun_arg="dryrun"; fi
			out "  ${IBlack}[${_del_host}] Deleting via SSH (-lllx)...${RstClr}"
			_del_ssh_cmd="{ cd '${OTS_SETUP_DIR}/otsdaq-mu2e-config' && source ./Fast_ots_setup.sh '${OTS_SETUP_TYPE}' logsdelete ${DELETE_LOGS_TIME_INT} ${DELETE_LOGS_TIME_UNIT} ${_del_dryrun_arg}; } 2>&1"
			_del_ssh_output=$(ssh -K -o ConnectTimeout=10 -o BatchMode=yes "$_del_host" \
				"$_del_ssh_cmd" 2>/dev/null)
			_del_ssh_rc=$?
			if [ $_del_ssh_rc -ne 0 ]; then
				_del_ssh_output=$(ssh -K -o ConnectTimeout=10 -o BatchMode=yes "${_del_host/-data/}" \
					"$_del_ssh_cmd" 2>/dev/null)
				_del_ssh_rc=$?
			fi
			if [ $_del_ssh_rc -ne 0 ]; then
				out "  ${Red}[${_del_host}] SSH delete failed. Skipping.${RstClr}"
			else
				while IFS= read -r _del_rline; do
					_del_clean=$(echo "$_del_rline" | sed 's/\x1b\[[0-9;]*m//g')
					if [[ "$_del_clean" == *" |"* ]]; then _del_clean="${_del_clean##* |}"; fi
					_del_clean="${_del_clean#"${_del_clean%%[![:space:]]*}"}"
					if [[ "$_del_clean" == DELETE* ]] || [[ "$_del_clean" == RMDIR* ]] || \
					   [[ "$_del_clean" == KEEP* ]] || [[ "$_del_clean" == *"files to delete"* ]] || \
					   [[ "$_del_clean" == *"Total files to delete"* ]] || [[ "$_del_clean" == *"not shown"* ]] || \
					   [[ "$_del_clean" == *"DRY RUN"* ]] || [[ "$_del_clean" == *"No log files older than"* ]] || \
					   [[ "$_del_clean" == *"older than"*"to delete"* ]] || \
					   [[ "$_del_clean" == *"empty subdirectories"* ]] || [[ "$_del_clean" == "Done." ]]; then
						out "    [${_del_host}] ${_del_clean}"
					fi
					if [[ "$_del_clean" =~ list\ of\ ([0-9]+)\ file ]]; then
						DELETE_LOGS_GRAND_TOTAL=$(( DELETE_LOGS_GRAND_TOTAL + ${BASH_REMATCH[1]} ))
						DELETE_LOGS_REMOTE_COUNT=$(( DELETE_LOGS_REMOTE_COUNT + ${BASH_REMATCH[1]} ))
					fi
				done <<< "$_del_ssh_output"
			fi
		done < "$_artdaq_ranks_file"
		unset _del_seen_hosts _del_host _del_host_stripped _del_line _del_ssh_cmd
		unset _del_ssh_output _del_ssh_rc _del_rline _del_clean _del_dryrun_arg _artdaq_ranks_file
	else
		out "  ${IBlack}No ranks.txt found. Skipping ARTDAQ host deletion.${RstClr}"
	fi

	# Now SSH to each remote OTS context host and run -llx on each (parallel, same pattern as ots -l)
	out
	out "${Bold}${Cyan}Deleting old logs on remote OTS context hosts...${RstClr}"
	_del_context_hosts=$(_logdelete_get_context_hosts)
	if [ -n "$_del_context_hosts" ]; then
		_del_dryrun_arg=""
		if [ "$DELETE_LOGS_DRYRUN" -eq 1 ]; then _del_dryrun_arg="dryrun"; fi
		_del_ssh_cmd="{ cd '${OTS_SETUP_DIR}/otsdaq-mu2e-config' && source ./Fast_ots_setup.sh '${OTS_SETUP_TYPE}' artdaqlogsdelete ${DELETE_LOGS_TIME_INT} ${DELETE_LOGS_TIME_UNIT} ${_del_dryrun_arg}; } 2>&1"
		_del_tmpdir=$(mktemp -d /tmp/ots_delctx_XXXXXX 2>/dev/null || { mkdir -p "/tmp/ots_delctx_$$" && echo "/tmp/ots_delctx_$$"; })

		declare -A _del_orig_pids
		declare -A _del_alt_pids
		declare -A _del_alt_hostmap
		declare -A _del_pid_label   # pid -> "host:role" for live debug output
		_del_ordered_hosts=()
		_del_total_jobs=0

		# DEBUG: wall-clock anchor for elapsed-time prints
		_del_t0=$(date +%s.%N)
		# DEBUG: instrument the remote command to print a one-line "remote up" marker
		# with the remote epoch -- lets us split SSH connect/auth time from remote work time.
		_del_ssh_cmd_dbg="echo \"__OTS_REMOTE_UP__ \$(date +%s.%N) \$(hostname)\"; ${_del_ssh_cmd}"

		# PRE-WARM Kerberos service tickets serially before the parallel SSH burst.
		# Each `ssh -K` to a new host triggers a TGS_REQ; firing 9 of them at once can
		# saturate the KDC (or the local FILE: ccache) and trigger ~30s retry timeouts.
		# Acquiring tickets one-at-a-time here populates the ccache so the parallel SSHs
		# reuse cached tickets and skip the KDC round-trip entirely. Failures are
		# non-fatal -- ssh will fall back to whatever it would have done anyway.
		if command -v kvno >/dev/null 2>&1; then
			out "  ${IBlack}Pre-warming Kerberos service tickets serially...${RstClr}"
			_del_kvno_t0=$(date +%s.%N)
			while IFS= read -r _del_host; do
				[ -z "$_del_host" ] && continue
				_del_alt_host="${_del_host/-data/}"
				_del_alt_host="${_del_alt_host/-ipmi/}"
				[ "$_del_alt_host" == "$_del_host" ] && _del_alt_host=""
				for _del_kvno_host in "$_del_host" "$_del_alt_host"; do
					[ -z "$_del_kvno_host" ] && continue
					_del_kvno_t1=$(date +%s.%N)
					kvno "host/${_del_kvno_host}" >/dev/null 2>&1
					_del_kvno_rc=$?
					_del_kvno_elapsed=$(awk "BEGIN{printf \"%.2f\", $(date +%s.%N) - $_del_kvno_t1}")
					# DEBUG: per-host kvno timing -- uncomment to diagnose Kerberos issues.
					# Expected: -data/-ipmi alt hostnames fail (no service principal); canonical names succeed.
					# if [ "$_del_kvno_rc" -eq 0 ]; then
					# 	out "    ${IBlack}[kvno host/${_del_kvno_host}] ok  in ${_del_kvno_elapsed}s${RstClr}"
					# else
					# 	out "    ${IBlack}[kvno host/${_del_kvno_host}] fail in ${_del_kvno_elapsed}s (rc=${_del_kvno_rc}) -- continuing${RstClr}"
					# fi
					: "${_del_kvno_rc} ${_del_kvno_elapsed} ${_del_kvno_host}"  # keep vars "used" for shellcheck
				done
			done <<< "$_del_context_hosts"
			_del_kvno_total=$(awk "BEGIN{printf \"%.2f\", $(date +%s.%N) - $_del_kvno_t0}")
			out "  ${IBlack}Pre-warm done in ${_del_kvno_total}s. Starting parallel SSH burst.${RstClr}"
			unset _del_kvno_t0 _del_kvno_t1 _del_kvno_host _del_kvno_rc _del_kvno_elapsed _del_kvno_total
			# Reset the t0 anchor so per-job "t+Xs" prints are relative to burst launch, not kvno start
			_del_t0=$(date +%s.%N)
		else
			out "  ${IBlack}kvno not in PATH -- skipping Kerberos pre-warm.${RstClr}"
		fi

		# Launch all SSH jobs in parallel -- original and stripped alt simultaneously
		while IFS= read -r _del_host; do
			[ -z "$_del_host" ] && continue
			_del_ordered_hosts+=("$_del_host")
			_del_safe_host="${_del_host//[^a-zA-Z0-9._-]/_}"

			_del_alt_host="${_del_host/-data/}"
			_del_alt_host="${_del_alt_host/-ipmi/}"
			[ "$_del_alt_host" == "$_del_host" ] && _del_alt_host=""

			# Per-host launch print: visibility into fork ordering AND structurally important.
			# The $(awk ...) and $(date ...) subshells fork/exec ~10-30ms each, providing a
			# natural inter-launch stagger that prevents the 9-way SSH burst from saturating
			# the local Kerberos client / KDC. Removing this line reproduces the 30-60s
			# slowdown (kvno pre-warm alone is not sufficient because -data alt hostnames
			# still trigger negative TGS_REQs at burst time -- see kvno fail lines above).
			out "  ${IBlack}[${_del_host}] Launching parallel SSH delete... (t+$(awk "BEGIN{printf \"%.2f\",$(date +%s.%N)-$_del_t0}")s)${RstClr}"

			( _t_launch=$(date +%s.%N)
			  echo "$_t_launch" > "${_del_tmpdir}/${_del_safe_host}.orig.tlaunch"
			  ssh -K -o ConnectTimeout=10 -o BatchMode=yes "$_del_host" \
				"$_del_ssh_cmd_dbg" > "${_del_tmpdir}/${_del_safe_host}.orig.out" 2>"${_del_tmpdir}/${_del_safe_host}.orig.err"
			  _rc=$?
			  echo "$_rc" > "${_del_tmpdir}/${_del_safe_host}.orig.rc"
			  date +%s.%N > "${_del_tmpdir}/${_del_safe_host}.orig.tend" ) &
			_del_orig_pids["$_del_host"]=$!
			_del_pid_label[${_del_orig_pids[$_del_host]}]="${_del_host}:orig"
			_del_total_jobs=$((_del_total_jobs + 1))

			if [ -n "$_del_alt_host" ]; then
				_del_alt_hostmap["$_del_host"]="$_del_alt_host"
				( _t_launch=$(date +%s.%N)
				  echo "$_t_launch" > "${_del_tmpdir}/${_del_safe_host}.alt.tlaunch"
				  ssh -K -o ConnectTimeout=10 -o BatchMode=yes "$_del_alt_host" \
					"$_del_ssh_cmd_dbg" > "${_del_tmpdir}/${_del_safe_host}.alt.out" 2>"${_del_tmpdir}/${_del_safe_host}.alt.err"
				  _rc=$?
				  echo "$_rc" > "${_del_tmpdir}/${_del_safe_host}.alt.rc"
				  date +%s.%N > "${_del_tmpdir}/${_del_safe_host}.alt.tend" ) &
				_del_alt_pids["$_del_host"]=$!
				_del_pid_label[${_del_alt_pids[$_del_host]}]="${_del_host}:alt(${_del_alt_host})"
				_del_total_jobs=$((_del_total_jobs + 1))
			fi
		done <<< "$_del_context_hosts"

		out "  ${IBlack}Waiting for ${#_del_ordered_hosts[@]} hosts (${_del_total_jobs} SSH jobs) to complete...${RstClr}"

		# DEBUG: wait for jobs as they complete (not in launch order) so slow hosts
		# stand out immediately. Print per-job timing: connect-to-remote-ready vs total.
		_del_done_count=0
		while [ "$_del_done_count" -lt "$_del_total_jobs" ]; do
			wait -n 2>/dev/null
			_wn_rc=$?
			# Scan for jobs that have produced a .tend but no .reported marker yet
			for _f in "${_del_tmpdir}"/*.tend; do
				[ -e "$_f" ] || continue
				_base="${_f%.tend}"
				[ -e "${_base}.reported" ] && continue
				touch "${_base}.reported"
				_del_done_count=$((_del_done_count + 1))
				_tag=$(basename "$_base")            # e.g. mu2e-calo-01-data.fnal.gov.orig
				_role="${_tag##*.}"                  # orig | alt
				_hostpart="${_tag%.*}"               # mu2e-calo-01-data.fnal.gov
				_t_launch=$(cat "${_base}.tlaunch" 2>/dev/null)
				_t_end=$(cat "${_base}.tend" 2>/dev/null)
				_rc=$(cat "${_base}.rc" 2>/dev/null)
				_elapsed=$(awk "BEGIN{printf \"%.2f\", ${_t_end:-0} - ${_t_launch:-0}}")
				# Pull the remote-up marker (first line of stdout) to compute SSH connect time
				_remote_up_line=$(head -1 "${_base}.out" 2>/dev/null)
				_remote_t=""
				_connect=""
				_work=""
				if [[ "$_remote_up_line" == __OTS_REMOTE_UP__* ]]; then
					_remote_t=$(echo "$_remote_up_line" | awk '{print $2}')
					# SSH connect time is approx (remote epoch - local launch epoch);
					# assumes clocks roughly sync'd (NTP). Negative => clock skew, ignore.
					_connect=$(awk "BEGIN{d=${_remote_t:-0}-${_t_launch:-0}; if(d<0)d=0; printf \"%.2f\", d}")
					_work=$(awk "BEGIN{printf \"%.2f\", ${_t_end:-0} - ${_remote_t:-0}}")
				fi
				if [ -n "$_remote_t" ]; then
					# DEBUG: per-job success timing -- uncomment to see connect vs remote-work breakdown.
					# Useful for diagnosing slow SSH (Kerberos KDC contention, sshd auth, network).
					# out "  ${IBlack}[${_hostpart}:${_role}] done in ${_elapsed}s (connect~${_connect}s, remote-work~${_work}s, rc=${_rc}) [${_del_done_count}/${_del_total_jobs}]${RstClr}"
					: "${_hostpart} ${_role} ${_elapsed} ${_connect} ${_work} ${_rc}"  # keep vars "used"
				else
					# Failure path stays visible -- SSH never ran the remote command (auth/connect failure)
					_stderr_first=$(head -1 "${_base}.err" 2>/dev/null | grep -v "^Warning:" | head -c 120)
					out "  ${Red}[${_hostpart}:${_role}] done in ${_elapsed}s (NO remote-up marker, rc=${_rc}) [${_del_done_count}/${_del_total_jobs}]${RstClr}"
					[ -n "$_stderr_first" ] && out "  ${Red}    stderr: ${_stderr_first}${RstClr}"
				fi
			done
			# Safety: if wait -n returned an error (no children) but we still think jobs are pending, bail
			if [ "$_wn_rc" -eq 127 ] || [ "$_wn_rc" -gt 128 ]; then
				# No more children to wait for -- count any tend files we may have missed
				for _f in "${_del_tmpdir}"/*.tend; do
					[ -e "$_f" ] || continue
					_base="${_f%.tend}"
					[ -e "${_base}.reported" ] || { touch "${_base}.reported"; _del_done_count=$((_del_done_count + 1)); }
				done
				break
			fi
		done
		_del_total_elapsed=$(awk "BEGIN{printf \"%.2f\", $(date +%s.%N) - $_del_t0}")
		out "  ${IBlack}All SSH jobs finished after ${_del_total_elapsed}s total.${RstClr}"

		# Parse results in order -- original wins over alt if both succeed
		for _del_host in "${_del_ordered_hosts[@]}"; do
			_del_safe_host="${_del_host//[^a-zA-Z0-9._-]/_}"
			_del_alt_host="${_del_alt_hostmap[$_del_host]:-}"

			_del_ssh_output=""
			_del_ssh_host_used=""
			_del_stderr_orig=$(cat "${_del_tmpdir}/${_del_safe_host}.orig.err" 2>/dev/null | grep -v "^Warning:" | head -3)
			_del_stderr_alt=""

			_del_rc_orig=$(cat "${_del_tmpdir}/${_del_safe_host}.orig.rc" 2>/dev/null)
			_del_rc_alt=""
			if [ "${_del_rc_orig}" = "0" ]; then
				# Strip the DEBUG __OTS_REMOTE_UP__ marker line injected by _del_ssh_cmd_dbg
				_del_ssh_output=$(grep -v '^__OTS_REMOTE_UP__' "${_del_tmpdir}/${_del_safe_host}.orig.out" 2>/dev/null)
				_del_ssh_host_used="$_del_host"
			elif [ -n "$_del_alt_host" ]; then
				_del_stderr_alt=$(cat "${_del_tmpdir}/${_del_safe_host}.alt.err" 2>/dev/null | grep -v "^Warning:" | head -3)
				_del_rc_alt=$(cat "${_del_tmpdir}/${_del_safe_host}.alt.rc" 2>/dev/null)
				if [ "${_del_rc_alt}" = "0" ]; then
					_del_ssh_output=$(grep -v '^__OTS_REMOTE_UP__' "${_del_tmpdir}/${_del_safe_host}.alt.out" 2>/dev/null)
					_del_ssh_host_used="$_del_alt_host"
				fi
			fi

			# For diagnostics: capture remote output even on failure (best available)
			_del_stdout_fail=""
			if [ -z "$_del_ssh_host_used" ]; then
				# prefer alt stdout if it connected (rc!=255), else orig
				if [ -n "$_del_alt_host" ] && [ "${_del_rc_alt}" != "255" ] && [ -n "${_del_rc_alt}" ]; then
					_del_stdout_fail=$(grep -v '^__OTS_REMOTE_UP__' "${_del_tmpdir}/${_del_safe_host}.alt.out" 2>/dev/null | tail -5)
				elif [ "${_del_rc_orig}" != "255" ] && [ -n "${_del_rc_orig}" ]; then
					_del_stdout_fail=$(grep -v '^__OTS_REMOTE_UP__' "${_del_tmpdir}/${_del_safe_host}.orig.out" 2>/dev/null | tail -5)
				fi
			fi

			rm -f "${_del_tmpdir}/${_del_safe_host}.orig.out"     "${_del_tmpdir}/${_del_safe_host}.orig.rc"  \
			      "${_del_tmpdir}/${_del_safe_host}.alt.out"      "${_del_tmpdir}/${_del_safe_host}.alt.rc"   \
			      "${_del_tmpdir}/${_del_safe_host}.orig.err"     "${_del_tmpdir}/${_del_safe_host}.alt.err"  \
			      "${_del_tmpdir}/${_del_safe_host}.orig.tlaunch" "${_del_tmpdir}/${_del_safe_host}.alt.tlaunch" \
			      "${_del_tmpdir}/${_del_safe_host}.orig.tend"    "${_del_tmpdir}/${_del_safe_host}.alt.tend"    \
			      "${_del_tmpdir}/${_del_safe_host}.orig.reported" "${_del_tmpdir}/${_del_safe_host}.alt.reported" 2>/dev/null

			if [ -z "$_del_ssh_host_used" ]; then
				if [ -n "$_del_alt_host" ]; then
					out "  ${Red}[${_del_host}] SSH delete failed to both ${_del_host} (rc=${_del_rc_orig}) and ${_del_alt_host} (rc=${_del_rc_alt}). Skipping.${RstClr}"
				else
					out "  ${Red}[${_del_host}] SSH delete failed (rc=${_del_rc_orig}). Skipping.${RstClr}"
				fi
				if [ -n "$_del_stderr_orig" ]; then
					out "  ${Red}  stderr(${_del_host}): ${_del_stderr_orig}${RstClr}"
				fi
				if [ -n "$_del_alt_host" ] && [ -n "$_del_stderr_alt" ]; then
					out "  ${Red}  stderr(${_del_alt_host}): ${_del_stderr_alt}${RstClr}"
				fi
				if [ -n "$_del_stdout_fail" ]; then
					out "  ${Red}  remote output (last lines):${RstClr}"
					while IFS= read -r _del_rline; do
						_del_clean=$(echo "$_del_rline" | sed 's/\x1b\[[0-9;]*m//g')
						if [[ "$_del_clean" == *" |"* ]]; then _del_clean="${_del_clean##* |}"; fi
						_del_clean="${_del_clean#"${_del_clean%%[![:space:]]*}"}"
						[ -n "$_del_clean" ] && out "  ${Red}    ${_del_clean}${RstClr}"
					done <<< "$_del_stdout_fail"
				fi
				continue
			fi

			while IFS= read -r _del_rline; do
				_del_clean=$(echo "$_del_rline" | sed 's/\x1b\[[0-9;]*m//g')
				if [[ "$_del_clean" == *" |"* ]]; then _del_clean="${_del_clean##* |}"; fi
				_del_clean="${_del_clean#"${_del_clean%%[![:space:]]*}"}"
				if [[ "$_del_clean" == DELETE* ]] || [[ "$_del_clean" == RMDIR* ]] || \
				   [[ "$_del_clean" == KEEP* ]] || [[ "$_del_clean" == *"files to delete"* ]] || \
				   [[ "$_del_clean" == *"Total files to delete"* ]] || [[ "$_del_clean" == *"not shown"* ]] || \
				   [[ "$_del_clean" == *"DRY RUN"* ]] || [[ "$_del_clean" == *"No log files older than"* ]] || \
				   [[ "$_del_clean" == *"older than"*"to delete"* ]] || \
				   [[ "$_del_clean" == *"empty subdirectories"* ]] || [[ "$_del_clean" == "Done." ]]; then
					out "    [${_del_host}] ${_del_clean}"
				fi
				if [[ "$_del_clean" =~ list\ of\ ([0-9]+)\ file ]]; then
					DELETE_LOGS_GRAND_TOTAL=$(( DELETE_LOGS_GRAND_TOTAL + ${BASH_REMATCH[1]} ))
					DELETE_LOGS_REMOTE_COUNT=$(( DELETE_LOGS_REMOTE_COUNT + ${BASH_REMATCH[1]} ))
				fi
			done <<< "$_del_ssh_output"
		done

		rm -rf "$_del_tmpdir" 2>/dev/null
		unset _del_ssh_cmd _del_ssh_cmd_dbg _del_ssh_output _del_rline _del_clean _del_host _del_alt_host _del_dryrun_arg
		unset _del_orig_pids _del_alt_pids _del_alt_hostmap _del_pid_label _del_tmpdir _del_safe_host _del_rc_orig _del_rc_alt
		unset _del_ordered_hosts _del_ssh_host_used _del_stderr_orig _del_stderr_alt _del_stdout_fail
		unset _del_t0 _del_total_jobs _del_done_count _del_total_elapsed
	else
		out "  ${IBlack}No remote OTS context hosts found in XML config.${RstClr}"
	fi
	unset _del_context_hosts
	out
	if [ "$DELETE_LOGS_DRYRUN" -eq 1 ]; then
		out "  ${IBlack}Local  (${THIS_HOST}): ${DELETE_LOGS_LOCAL_COUNT} file(s) would be deleted.${RstClr}"
		out "  ${IBlack}Remote (all hosts):  ${DELETE_LOGS_REMOTE_COUNT} file(s) would be deleted.${RstClr}"
		out "${Bold}${Cyan}GRAND TOTAL: ${DELETE_LOGS_GRAND_TOTAL} file(s) would be deleted (if this were not a DRY RUN).${RstClr}"
	else
		out "  ${IBlack}Local  (${THIS_HOST}): ${DELETE_LOGS_LOCAL_COUNT} file(s) deleted.${RstClr}"
		out "  ${IBlack}Remote (all hosts):  ${DELETE_LOGS_REMOTE_COUNT} file(s) deleted.${RstClr}"
		out "${Bold}${Cyan}GRAND TOTAL: ${DELETE_LOGS_GRAND_TOTAL} file(s) deleted across all hosts.${RstClr}"
	fi
	exit
fi

