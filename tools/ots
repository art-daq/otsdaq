function killproc
{
	pid=$1
	type=$2

	if [ $ISREMOTE == 0 ]; then
		out "${Red}${Rev}Killing process ID ${pid} ${type}${RstClr}"
	fi

	count=10
	kill -9 ${pid} >/dev/null 2>&1  #gentler abort sig seems to cause core dumps
	# kill -0 ${pid} >/dev/null 2>&1
	while [ $? -eq 0 ]; do
		kill ${pid} >/dev/null 2>&1
		sleep 1
		count=$(( $count - 1 ))
		if [ $count -le 0 ]; then
			kill -9 ${pid} >/dev/null 2>&1
		fi

		kill -0 ${pid} >/dev/null 2>&1
	done
}
export -f killproc

